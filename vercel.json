{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/custom-stamps", "has": [{ "type": "host", "value": "springfieldstamp.com" }], "destination": "https://www.springfieldstamp.com/custom-stamps/", "statusCode": 301 },
    { "source": "/missouri-notary-stamp", "has": [{ "type": "host", "value": "springfieldstamp.com" }], "destination": "https://www.springfieldstamp.com/missouri-notary-stamp/", "statusCode": 301 },
    { "source": "/magnetic-name-tags", "has": [{ "type": "host", "value": "springfieldstamp.com" }], "destination": "https://www.springfieldstamp.com/magnetic-name-tags/", "statusCode": 301 },
    { "source": "/about", "has": [{ "type": "host", "value": "springfieldstamp.com" }], "destination": "https://www.springfieldstamp.com/about/", "statusCode": 301 },
    { "source": "/contact", "has": [{ "type": "host", "value": "springfieldstamp.com" }], "destination": "https://www.springfieldstamp.com/contact/", "statusCode": 301 },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "springfieldstamp.com" }], "destination": "https://www.springfieldstamp.com/$1", "statusCode": 301 },
    { "source": "/custom-stamps", "destination": "/custom-stamps/", "statusCode": 301 },
    { "source": "/missouri-notary-stamp", "destination": "/missouri-notary-stamp/", "statusCode": 301 },
    { "source": "/magnetic-name-tags", "destination": "/magnetic-name-tags/", "statusCode": 301 },
    { "source": "/about", "destination": "/about/", "statusCode": 301 },
    { "source": "/contact", "destination": "/contact/", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/api/site-events", "destination": "/api/site-events/" }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/((?!_astro/|images/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
