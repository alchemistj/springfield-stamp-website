---
// Base layout for every page: head (SEO, canonical, Open Graph, JSON-LD, Google tag), the
// above-the-fold `.atf` block (photo first, then header, then hero, then the `.atf-ready` marker),
// the page content, and the footer.
//
//   <BaseLayout route={routeByKey("home")} heroHeight={{ desktop: 562, mobile: 196 }}>
//     <HeroPhoto slot="hero-photo" mobile={...} desktop={...} />
//     <section slot="hero"> ...H1... </section>
//     ...page sections...
//   </BaseLayout>
//
// Pages without a photo hero omit both slots; the header then sits alone in `.atf`.
import "../styles/global.css";
import { getImage } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_URL } from "../data/site";
import { canonicalUrl, type Route } from "../lib/routes";
import { ogImages } from "../lib/images";
import { breadcrumbSchema, jsonLd, localBusinessSchema } from "../lib/seo";

interface Props {
  route: Route;
  /** Hero heights in px per breakpoint (default 562 desktop, 196 mobile). Sets --hero-h-d / --hero-h-m on .atf. */
  heroHeight?: { desktop?: number; mobile?: number };
  /** 1200px-wide header (About, Contact, Custom Stamps, Magnetic Name Tags on the live site). Default 1080px. */
  wideHeader?: boolean;
}
const { route, heroHeight, wideHeader = false } = Astro.props;

const canonical = canonicalUrl(route.path);
const og = await getImage({ src: ogImages[route.key], format: "jpeg", quality: 80 });
const ogUrl = new URL(og.src, SITE_URL).toString();
const atfStyle = [
  heroHeight?.desktop ? `--hero-h-d:${heroHeight.desktop}px` : "",
  heroHeight?.mobile ? `--hero-h-m:${heroHeight.mobile}px` : "",
]
  .filter(Boolean)
  .join(";");
const GTAG_ID = "GT-WK5CGGGZ";
const gtagInline = `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag("js",new Date());gtag("config","${GTAG_ID}");`;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{route.title}</title>
    <meta name="description" content={route.description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={route.ogType} />
    <meta property="og:title" content={route.title} />
    <meta property="og:description" content={route.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Springfield Stamp" />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={jsonLd(localBusinessSchema())} />
    <script type="application/ld+json" set:html={jsonLd(breadcrumbSchema(route))} />
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GTAG_ID}`}></script>
    <script is:inline set:html={gtagInline} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="atf" style={atfStyle || undefined}>
      <slot name="hero-photo" />
      <Header current={route.path} wide={wideHeader} />
      <slot name="hero" />
      <span class="atf-ready" hidden></span>
    </div>
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
