---
// Sticky bottom bar on phones: Call Now (tel) and Email Us (mailto). Hidden from 1024px up.
// Both use the shared primary button. Labels live in src/data/site.ts.
import { site, stickyBar } from "../data/site";
import Button from "./Button.astro";
---

<div class="call-bar" role="region" aria-label={stickyBar.regionLabel}>
  <div class="call-bar-row">
    <Button href={site.phone.tel} class="cb-btn" aria-label={`${stickyBar.callLabel}: call ${site.name} at ${site.phone.display}`}>
      {stickyBar.callLabel}
    </Button>
    <Button href={`mailto:${site.email}`} class="cb-btn" aria-label={`${stickyBar.emailLabel}: email ${site.name} at ${site.email}`}>
      {stickyBar.emailLabel}
    </Button>
  </div>
</div>

<style>
  .call-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 60;
    box-sizing: border-box;
    background: #fff;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  .call-bar-row {
    display: flex;
    align-items: stretch;
    gap: 10px;
    padding: 8px 12px;
  }
  .call-bar-row :global(.cb-btn) {
    flex: 1 1 0;
  }
  @media (min-width: 1024px) {
    .call-bar {
      display: none;
    }
  }
</style>
