---
// Sticky bottom bar on phones: Call Now (tel: NAP) and Email Us (mailto:). Hidden from 1024px up, the
// same breakpoint where the header switches to its desktop layout (so no width loses its phone link).
// Labels live in src/data/site.ts. Shows labels, not digits (Rule 7.2). Zero JS; the page gets bottom
// room from --callbar-h in global.css. Rendered last in <body>, after .atf, so it never delays the first frame.
import { site, stickyBar } from "../data/site";
---

<div class="call-bar" role="region" aria-label={stickyBar.regionLabel}>
  <div class="call-bar-row">
    <a class="cb-btn" href={site.phone.tel} aria-label={`${stickyBar.callLabel}: call ${site.name} at ${site.phone.display}`}>
      {stickyBar.callLabel}
    </a>
    <a class="cb-btn" href={`mailto:${site.email}`} aria-label={`${stickyBar.emailLabel}: email ${site.name} at ${site.email}`}>
      {stickyBar.emailLabel}
    </a>
  </div>
</div>

<style>
  .call-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 60;
    box-sizing: border-box;
    background: #fff;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.12);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  .call-bar-row {
    display: flex;
    gap: 10px;
    padding: 8px 12px;
  }
  .cb-btn {
    flex: 1 1 0;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-height: 48px;
    border-radius: var(--radius-pill);
    background: var(--color-ss-yellow);
    color: var(--color-ss-ink);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 18px;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }
  .cb-btn:active {
    transform: translateY(1px);
  }
  @media (min-width: 1024px) {
    .call-bar {
      display: none;
    }
  }
</style>
