---
// Full-width page section. The background runs edge to edge; the words stay in the shared 900px column.
//   tone "surface" = light grey (#f2f2f2), "maroon" = the red workflow band, "white", "about" = grey (#efefef).
interface Props {
  tone?: "surface" | "maroon" | "white" | "about";
  id?: string;
  class?: string;
  /** Vertical padding (top / bottom), desktop and mobile. */
  padTop?: [number, number];
  padBottom?: [number, number];
  /** Background colour override (the live product pages use slightly different greys). */
  bg?: string;
}
const { tone = "white", id, class: className, padTop = [81, 51], padBottom = [80, 70], bg } = Astro.props;
const style = `${bg ? `--sec-bg:${bg};` : ""}--pt:${padTop[0]}px;--pt-m:${padTop[1]}px;--pb:${padBottom[0]}px;--pb-m:${padBottom[1]}px`;
---

<section id={id} class:list={["section", `tone-${tone}`, { "has-bg": !!bg }, className]} style={style}>
  <div class="inner"><slot /></div>
</section>

<style>
  .section {
    padding: var(--pt-m) 0 var(--pb-m);
  }
  .inner {
    box-sizing: border-box;
    width: min(var(--content-max), calc(100% - 2 * var(--content-pad)));
    margin-inline: auto;
  }
  .tone-surface {
    background: var(--color-ss-surface);
  }
  .tone-maroon {
    background: var(--color-ss-maroon);
    color: #fff;
  }
  .tone-white {
    background: #fff;
  }
  .tone-about {
    background: var(--color-ss-about);
  }
  .has-bg {
    background: var(--sec-bg);
  }
  @media (min-width: 1024px) {
    .section {
      padding: var(--pt) 0 var(--pb);
    }
  }
</style>
