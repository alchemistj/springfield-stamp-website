---
// Alternating image / text product row. Put several inside <ProductRows>.
// `reverse` puts the picture on the right on desktop. Both columns are equal.
// `fit` "cover" crops to the cell (homepage photos). "contain" shows the whole
// cut-out, centred, at `photoScale` percent of the cell.
// `tone` "card" / "card-alt" is the homepage boxed row. "plain" is a white row with no card.
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Button from "./Button.astro";

interface Props {
  title: string;
  image?: ImageMetadata;
  imageAlt?: string;
  headingLevel?: "h2" | "h3" | "h4";
  /** Picture on the right (desktop). */
  reverse?: boolean;
  /** Homepage boxed rows keep a grey panel. Other pages use plain white. */
  tone?: "card" | "card-alt" | "plain";
  ctaHref?: string;
  ctaLabel?: string;
  /** CSS object-position when the cover crop would cut the product. */
  objectPosition?: string;
  /** cover crops. contain shows the whole photo, centred on white. */
  fit?: "cover" | "contain";
  /** Percent of the cell a contained photo may fill. 100 fills the cell. */
  photoScale?: number;
  /** Phone max-height for a contained photo. Desktop uses the cell instead. */
  phoneMaxHeight?: number;
  /** Phone only: photo at 80% of the card, max 300px, with this much white above and below. */
  phoneInset?: number;
}
const {
  title,
  image,
  imageAlt = "",
  headingLevel: Heading = "h3",
  reverse = false,
  tone = "plain",
  ctaHref,
  ctaLabel,
  objectPosition = "50% 50%",
  fit = "cover",
  photoScale = 80,
  phoneMaxHeight,
  phoneInset,
} = Astro.props;
const contain = fit === "contain";
---

<article
  class:list={["row", { reverse, "fit-contain": contain, "scale-full": contain && photoScale >= 100, cap: contain && phoneMaxHeight != null, "phone-inset": phoneInset != null }]}
  style={`--obj:${objectPosition};--photo-scale:${photoScale}%;${phoneMaxHeight != null ? `--photo-cap:${phoneMaxHeight}px;` : ""}${phoneInset != null ? `--phone-inset:${phoneInset}px;` : ""}`}
>
  <div class="media">
    {
      image && (
        <Picture
          src={image}
          alt={imageAlt}
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          widths={[400, 606, 800, 1200]}
          sizes="(min-width: 1024px) 450px, 100vw"
          quality={75}
        />
      )
    }
  </div>
  <div class:list={["copy", `tone-${tone}`]}>
    <Heading class="row-title">{title}</Heading>
    <div class="row-body"><slot /></div>
    {ctaHref && ctaLabel && <Button href={ctaHref} class="row-cta">{ctaLabel}</Button>}
  </div>
</article>

<style>
  .row {
    display: block;
    margin: 0;
    background: #fff;
  }
  .media {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: #fff;
  }
  .media :global(picture),
  .media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--obj, 50% 50%);
  }
  .copy {
    padding: 8px 0 0;
    text-align: left;
    background: #fff;
  }
  .tone-card {
    background: var(--color-ss-card);
  }
  .tone-card-alt {
    background: var(--color-ss-card-alt);
  }
  /* Contained photos sit on white, centred, at their own height. No 4:3 band. */
  .fit-contain .media {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: auto;
    height: auto;
    background: #fff;
  }
  .fit-contain .media :global(picture) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: auto;
  }
  .fit-contain .media :global(img) {
    width: auto;
    height: auto;
    max-width: var(--photo-scale, 80%);
    object-fit: contain;
    object-position: center;
  }
  @media (max-width: 1023px) {
    .copy.tone-card,
    .copy.tone-card-alt {
      box-sizing: border-box;
      padding: 20px;
    }
    .copy.tone-card .row-title,
    .copy.tone-card-alt .row-title {
      margin-top: 0;
    }
    .copy.tone-card .row-body,
    .copy.tone-card-alt .row-body {
      margin-bottom: 16px;
    }
    /* A definite width plus height:auto lets the width/height attributes reserve the box before the file arrives. */
    .fit-contain.cap .media {
      display: block;
    }
    .fit-contain.cap .media :global(picture) {
      display: block;
      width: min(var(--photo-scale, 80%), 100%);
      margin-inline: auto;
    }
    .fit-contain.cap .media :global(img) {
      display: block;
      width: 100%;
      height: auto;
      max-width: 100%;
      max-height: var(--photo-cap, 220px);
    }
    .fit-contain.phone-inset .media {
      display: block;
      box-sizing: border-box;
      padding: var(--phone-inset, 24px) 0;
      aspect-ratio: auto;
      height: auto;
    }
    .fit-contain.phone-inset .media :global(picture) {
      display: block;
      width: min(80%, 300px);
      margin-inline: auto;
    }
    .fit-contain.phone-inset .media :global(img) {
      display: block;
      width: 100%;
      height: auto;
      max-width: 100%;
      max-height: none;
    }
  }
  .row-title {
    margin: 16px 0 12px;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.3;
    color: #000;
  }
  .row-body {
    margin: 0 0 16px;
    text-align: left;
    font-family: var(--font-heading);
    font-size: 18px;
    line-height: 1.65;
    color: var(--color-ss-ink);
  }
  .row-body :global(p) {
    margin: 0;
  }
  .row-body :global(p + p) {
    margin-top: 14px;
  }
  .row-body :global(strong) {
    font-weight: 600;
  }

  @media (min-width: 1024px) {
    .row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: stretch;
    }
    .media {
      aspect-ratio: auto;
      height: 100%;
      min-height: 0;
    }
    .fit-contain .media {
      height: 100%;
    }
    .fit-contain .media :global(picture) {
      height: 100%;
    }
    .fit-contain .media :global(img) {
      width: var(--photo-scale, 80%);
      height: var(--photo-scale, 80%);
      max-width: var(--photo-scale, 80%);
      max-height: var(--photo-scale, 80%);
    }
    .fit-contain.scale-full .media :global(img) {
      width: 100%;
      height: 100%;
      max-width: 100%;
      max-height: 100%;
    }
    /* Product-page photos must not set the row height. The text column does.
       The picture is taken out of flow so a landscape file cannot stretch the row. */
    .fit-contain.cap .media {
      position: relative;
      min-height: 240px;
      height: auto;
    }
    .fit-contain.cap .media :global(picture) {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      margin: 0;
    }
    .fit-contain.cap .media :global(img) {
      width: auto;
      height: auto;
      max-width: var(--photo-scale, 80%);
      max-height: 100%;
      object-fit: contain;
    }
    .reverse .media {
      order: 2;
    }
    .copy {
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 32px 40px;
    }
    .tone-plain {
      background: #fff;
    }
    .row-title {
      margin: 0 0 16px;
      font-size: 24px;
      line-height: 1.3;
    }
    .row-body {
      margin-bottom: 20px;
    }
  }
</style>
