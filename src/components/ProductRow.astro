---
// Alternating image / text product row. Put several inside <ProductRows>.
// `reverse` puts the picture on the right on desktop. Both columns are equal.
// The photo fills its cell edge to edge (object-fit: cover). The row height comes from the text.
// `tone` "card" / "card-alt" is the homepage boxed row. "plain" is a white row with no card.
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Button from "./Button.astro";

interface Props {
  title: string;
  image?: ImageMetadata;
  imageAlt?: string;
  headingLevel?: "h2" | "h3" | "h4";
  /** Picture on the right (desktop). */
  reverse?: boolean;
  /** Homepage boxed rows keep a grey panel. Other pages use plain white. */
  tone?: "card" | "card-alt" | "plain";
  ctaHref?: string;
  ctaLabel?: string;
  /** CSS object-position when the cover crop would cut the product. */
  objectPosition?: string;
  /** A product cut-out on white. Natural aspect, not a cover crop. */
  cutout?: boolean;
  /** Show the whole image width, anchored to the bottom of the cell. */
  banner?: boolean;
}
const {
  title,
  image,
  imageAlt = "",
  headingLevel: Heading = "h3",
  reverse = false,
  tone = "plain",
  ctaHref,
  ctaLabel,
  objectPosition = "50% 50%",
  cutout = false,
  banner = false,
} = Astro.props;
---

<article class:list={["row", { reverse, cutout, banner }]} style={`--obj:${objectPosition}`}>
  <div class="media">
    {
      image && (
        <Picture
          src={image}
          alt={imageAlt}
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          widths={[400, 606, 800, 1200]}
          sizes="(min-width: 1024px) 450px, 100vw"
          quality={75}
        />
      )
    }
  </div>
  <div class:list={["copy", `tone-${tone}`]}>
    <Heading class="row-title">{title}</Heading>
    <div class="row-body"><slot /></div>
    {ctaHref && ctaLabel && <Button href={ctaHref} class="row-cta">{ctaLabel}</Button>}
  </div>
</article>

<style>
  .row {
    display: block;
    margin: 0;
    background: #fff;
  }
  /* 4:3 reserves the phone box before the file arrives. The picture fills it. */
  .media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: #fff;
  }
  .media :global(picture),
  .media :global(img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--obj, 50% 50%);
  }
  .copy {
    padding: 8px 0 0;
    text-align: left;
    background: #fff;
  }
  .tone-card {
    background: var(--color-ss-card);
  }
  .tone-card-alt {
    background: var(--color-ss-card-alt);
  }
  .row-title {
    margin: 16px 0 12px;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.3;
    color: #000;
  }
  .row-body {
    margin: 0 0 16px;
    text-align: left;
    font-family: var(--font-heading);
    font-size: 18px;
    line-height: 1.65;
    color: var(--color-ss-ink);
  }
  .row-body :global(p) {
    margin: 0;
  }
  .row-body :global(p + p) {
    margin-top: 14px;
  }
  .row-body :global(strong) {
    font-weight: 600;
  }
  .copy :global(.row-cta) {
    align-self: flex-start;
    width: auto;
    max-width: 100%;
  }
  /* One homepage photo: the whole width, sitting on the bottom of a taller cell.
     The band above matches the grey at the top of the picture. */
  .banner .media {
    background: linear-gradient(90deg, #c1c1c1 0%, #ebebeb 50%, #d6d6d6 100%);
  }
  .banner .media :global(picture),
  .banner .media :global(img) {
    object-fit: contain;
    object-position: center bottom;
  }
  /* Phones: a trimmed cut-out at its own shape, centred, no tall empty cell. */
  .cutout .media {
    aspect-ratio: auto;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: visible;
    background: transparent;
  }
  .cutout .media :global(picture) {
    position: static;
    inset: auto;
    width: min(80%, 320px);
    max-width: 80%;
    height: auto;
  }
  .cutout .media :global(img) {
    position: static;
    inset: auto;
    width: 100%;
    max-width: none;
    height: auto;
    object-fit: contain;
  }

  @media (max-width: 1023px) {
    .copy.tone-card,
    .copy.tone-card-alt {
      box-sizing: border-box;
      padding: 20px;
    }
    .copy.tone-card .row-title,
    .copy.tone-card-alt .row-title {
      margin-top: 0;
    }
    .copy.tone-card .row-body,
    .copy.tone-card-alt .row-body {
      margin-bottom: 16px;
    }
    /* The stamp banner is almost square. Match it so the full width shows. */
    .banner .media {
      aspect-ratio: 1024 / 992;
    }
  }

  @media (min-width: 1024px) {
    .row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: stretch;
    }
    .media {
      aspect-ratio: auto;
      height: 100%;
      min-height: 0;
    }
    .reverse .media {
      order: 2;
    }
    .copy {
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 32px 40px;
    }
    .tone-plain {
      background: #fff;
    }
    .row-title {
      margin: 0 0 16px;
      font-size: 24px;
      line-height: 1.3;
    }
    .row-body {
      margin-bottom: 20px;
    }
    /* At least as tall as the banner photo, so the full width still shows
       when the text column is the shorter one. A taller column leaves grey above. */
    .banner .media {
      height: auto;
    }
    .banner .media::before {
      content: "";
      display: block;
      padding-top: calc(992 / 1024 * 100%);
    }
    /* Desktop: the text still sets the row. The cut-out sits centred, uncropped. */
    .cutout .media {
      display: block;
      height: 100%;
      overflow: hidden;
    }
    .cutout .media :global(picture),
    .cutout .media :global(img) {
      position: absolute;
      inset: 0;
      width: 100%;
      max-width: none;
      height: 100%;
      object-fit: contain;
      object-position: center;
    }
  }
</style>
