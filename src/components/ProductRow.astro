---
// Alternating image / text product row. Put several inside <ProductRows>.
// `reverse` puts the picture on the right on desktop. Both columns are equal.
// On phones the picture is on top, full width, 4:3, cropped with cover.
// `tone` "card" / "card-alt" is the homepage boxed row. "plain" is a white row with no card.
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Button from "./Button.astro";

interface Props {
  title: string;
  image?: ImageMetadata;
  imageAlt?: string;
  headingLevel?: "h2" | "h3" | "h4";
  /** Picture on the right (desktop). */
  reverse?: boolean;
  /** Homepage boxed rows keep a grey panel. Other pages use plain white. */
  tone?: "card" | "card-alt" | "plain";
  ctaHref?: string;
  ctaLabel?: string;
  /** CSS object-position when the cover crop would cut the product. */
  objectPosition?: string;
}
const {
  title,
  image,
  imageAlt = "",
  headingLevel: Heading = "h3",
  reverse = false,
  tone = "plain",
  ctaHref,
  ctaLabel,
  objectPosition = "50% 50%",
} = Astro.props;
---

<article class:list={["row", { reverse }]} style={`--obj:${objectPosition}`}>
  <div class="media">
    {
      image && (
        <Picture
          src={image}
          alt={imageAlt}
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          widths={[400, 606, 800, 1200]}
          sizes="(min-width: 1024px) 450px, 100vw"
          quality={75}
        />
      )
    }
  </div>
  <div class:list={["copy", `tone-${tone}`]}>
    <Heading class="row-title">{title}</Heading>
    <div class="row-body"><slot /></div>
    {ctaHref && ctaLabel && <Button href={ctaHref} class="row-cta">{ctaLabel}</Button>}
  </div>
</article>

<style>
  .row {
    display: block;
    margin: 0;
    background: #fff;
  }
  .media {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: #fff;
  }
  .media :global(picture),
  .media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--obj, 50% 50%);
  }
  .copy {
    padding: 8px 0 0;
    text-align: left;
    background: #fff;
  }
  .row-title {
    margin: 16px 0 12px;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.3;
    color: #000;
  }
  .row-body {
    margin: 0 0 16px;
    text-align: left;
    font-family: var(--font-heading);
    font-size: 18px;
    line-height: 1.65;
    color: var(--color-ss-ink);
  }
  .row-body :global(p) {
    margin: 0;
  }
  .row-body :global(p + p) {
    margin-top: 14px;
  }
  .row-body :global(strong) {
    font-weight: 600;
  }

  @media (min-width: 1024px) {
    .row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: stretch;
    }
    .media {
      aspect-ratio: auto;
      height: 100%;
      min-height: 100%;
    }
    .reverse .media {
      order: 2;
    }
    .copy {
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 32px 40px;
    }
    .tone-card {
      background: var(--color-ss-card);
    }
    .tone-card-alt {
      background: var(--color-ss-card-alt);
    }
    .tone-plain {
      background: #fff;
    }
    .row-title {
      margin: 0 0 16px;
      font-size: 24px;
      line-height: 1.3;
    }
    .row-body {
      margin-bottom: 20px;
    }
  }
</style>
