---
// Site footer: description, INFORMATION (with About), CONTACT US (NAP, hours) and SOCIAL.
// A copyright row sits at the very bottom. Phone and email come from src/data/site.ts.
import { Image } from "astro:assets";
import { footer, site } from "../data/site";
import logoWhite from "../assets/springfield-stamp-logo-white.png";
import Icon from "./Icon.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="ft-inner">
    <div class="cols">
      <div class="col col-logo">
        <a class="logo-link" href="/" aria-label="Springfield Stamp & Engraving: home">
          <Image src={logoWhite} alt="springfield-stamps logo" width={240} height={78} densities={[1, 2]} format="webp" />
        </a>
        <p class="ft-desc">{footer.description}</p>
        <p class="ft-area">{footer.serviceArea}</p>
      </div>
      <div class="col col-info">
        <p class="ft-heading">{footer.informationHeading}</p>
        <ul class="ft-links">
          {footer.links.map((l) => <li><a href={l.path}>{l.label}</a></li>)}
        </ul>
      </div>
      <div class="col col-contact">
        <p class="ft-heading">{footer.contactHeading}</p>
        <ul class="ft-contact">
          <li class="addr">
            <Icon name="pin" class="ico" />
            <span>
              <span class="legal">{site.legalName}</span><br />{site.address.street}<br />{site.address.city}, {site.address.region} {site.address.postalCode}
            </span>
          </li>
          <li>
            <Icon name="phone" class="ico" />
            <a href={site.phone.tel}>{site.phone.display}</a>
          </li>
          <li>
            <Icon name="mail" class="ico" />
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li class="hours">{site.hours.days} {site.hours.times}</li>
        </ul>
      </div>
      <div class="col col-social">
        <p class="ft-heading">{footer.socialHeading}</p>
        <a class="fb" href={site.facebook} target="_blank" rel="noopener nofollow" aria-label="Springfield Stamp on Facebook">
          <Icon name="facebook" />
        </a>
      </div>
    </div>
    <p class="copyright">© {year} Springfield Stamp & Engraving, Inc. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-ss-footer);
    color: #fff;
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.55;
  }
  .ft-inner {
    box-sizing: border-box;
    width: min(1100px, calc(100% - 2 * var(--content-pad)));
    margin: 0 auto;
    padding: 28px 0 8px;
  }
  .cols {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .logo-link {
    display: block;
  }
  .col-logo img {
    display: block;
    width: min(213px, 100%);
    height: auto;
  }
  .ft-desc,
  .ft-area {
    margin: 12px 0 0;
    max-width: 36ch;
    color: rgba(255, 255, 255, 0.92);
  }
  .ft-heading {
    margin: 20px 0 10px;
    font-weight: 800;
    font-size: 13px;
    line-height: 22px;
    letter-spacing: 2px;
    color: rgba(255, 255, 255, 0.97);
  }
  .ft-links,
  .ft-contact {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ft-links li {
    margin: 0;
    padding: 3px 0;
    line-height: 26px;
  }
  .ft-links a {
    color: #fff;
    text-decoration: none;
  }
  .ft-links a:hover,
  .ft-contact a:hover {
    text-decoration: underline;
  }
  .ft-contact li {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    margin-bottom: 8px;
  }
  .ft-contact .hours {
    display: block;
    padding-left: 25px;
  }
  .legal {
    white-space: nowrap;
  }
  .ft-contact a {
    color: var(--color-ss-yellow);
    text-decoration: none;
  }
  .ft-contact :global(.ico) {
    flex: none;
    width: 16px;
    height: 16px;
    margin-top: 3px;
    color: var(--color-ss-red);
  }
  .fb {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: linear-gradient(to right bottom, var(--color-ss-red) 49%, rgba(23, 23, 22, 0.7) 49%, #aa1c29 50%);
    color: #fff;
  }
  .fb :global(svg) {
    width: 14px;
    height: 14px;
  }
  .copyright {
    margin: 20px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--color-ss-footer-line);
    font-size: 13px;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.85);
  }

  @media (min-width: 1024px) {
    .ft-inner {
      padding: 36px 0 12px;
    }
    .cols {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: 28px;
      align-items: start;
    }
    .ft-heading {
      margin: 0 0 12px;
      min-height: 22px;
    }
    .logo-link {
      min-height: 22px;
      display: flex;
      align-items: flex-start;
    }
    .col-logo img {
      width: 100%;
      max-width: 213px;
    }
    .ft-desc {
      margin-top: 14px;
    }
  }
</style>
