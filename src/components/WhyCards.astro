---
// 2 x 2 grid of icon cards ("Why choose Springfield Stamp?"). All grey. Cards size to their content
// and stretch to equal height in a row.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Rich } from "../data/types";
import RichText from "./Rich.astro";

interface Props {
  items: readonly { icon: ImageMetadata; title: string; body: Rich }[];
}
const { items } = Astro.props;
const iconSize = 44;
---

<div class="cards">
  {
    items.map((it) => (
      <div class="card">
        <Image class="ico" src={it.icon} alt="" width={iconSize} height={iconSize} densities={[1, 2]} format="webp" />
        <h3 class="ttl">{it.title}</h3>
        <p class="txt">
          <RichText parts={it.body} />
        </p>
      </div>
    ))
  }
</div>

<style>
  .cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    align-items: stretch;
  }
  .card {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    padding: 24px 24px 20px;
    border-radius: 20px;
    background: #e4e4e4;
  }
  .ico {
    display: block;
    width: 44px;
    height: 44px;
    margin: 0 0 16px;
    object-fit: contain;
  }
  .ttl {
    margin: 0 0 10px;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 18px;
    line-height: 1.35;
    color: var(--color-ss-ink);
  }
  .txt {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 18px;
    line-height: 1.65;
    color: var(--color-ss-ink);
  }
  .txt :global(strong) {
    font-weight: 600;
  }
  @media (min-width: 1024px) {
    .cards {
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    .card {
      padding: 28px 28px 20px;
    }
  }
</style>
