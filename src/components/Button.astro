---
// The two button variants used everywhere.
// primary: yellow pill. secondary: outline pill (white on a deep-red band, ink on a light page).
// One size, weight 600, one letter spacing, no shadow, 48px tall (above the 44px minimum). The label sizes the pill.
//   <Button href="/contact/">Get in Touch</Button>
//   <Button href="mailto:orders@springfieldstamp.com" variant="secondary">Email Us</Button>
//   <Button type="submit" disabled>Send Message</Button>
interface Props {
  href?: string;
  variant?: "primary" | "secondary";
  /** Render a <button> instead of a link (the contact form submit). */
  type?: "submit" | "button";
  disabled?: boolean;
  class?: string;
  id?: string;
  "aria-label"?: string;
}
const { href, variant = "primary", type, disabled = false, class: className, id, "aria-label": ariaLabel } = Astro.props;
const classes = ["btn", variant === "secondary" ? "btn-secondary" : "btn-primary", className];
---

{
  href ? (
    <a href={href} id={id} class:list={classes} aria-label={ariaLabel}>
      <span class="btn-label"><slot /></span>
    </a>
  ) : (
    <button type={type ?? "button"} id={id} class:list={classes} disabled={disabled} data-submit={type === "submit" ? true : undefined}>
      <span class="btn-label"><slot /></span>
    </button>
  )
}

<style is:global>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: auto;
    max-width: 100%;
    min-height: 48px;
    margin: 0;
    padding: 10px 22px;
    border: 2px solid transparent;
    border-radius: var(--radius-pill);
    background: var(--color-ss-yellow);
    color: var(--color-ss-ink);
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: normal;
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    text-transform: none;
    white-space: normal;
    box-shadow: none;
    cursor: pointer;
    transition: transform 0.15s ease;
  }
  .btn-primary {
    background: var(--color-ss-yellow);
    border-color: var(--color-ss-yellow);
    color: var(--color-ss-ink);
  }
  .btn-secondary {
    background: transparent;
    border-color: currentColor;
    color: var(--color-ss-ink);
  }
  .tone-maroon .btn-secondary,
  .final-cta .btn-secondary,
  .closing .btn-secondary {
    color: #fff;
    border-color: #fff;
  }
  .btn-label {
    display: block;
  }
  .btn:hover {
    transform: translateY(-1px);
  }
  .btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }
</style>
