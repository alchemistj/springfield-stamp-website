---
// One review, as its own full-width band. Quote, then name and role. The quote mark sits in the band.
// Dark text on the light band. The same style is used for every review.
import { Image } from "astro:assets";
import quoteMark from "../assets/springfield-stamp-testimonial.png";

interface Props {
  quote: string;
  name: string;
  role: string;
}
const { quote, name, role } = Astro.props;
---

<section class="review-band">
  <figure class="review">
    <Image class="mark" src={quoteMark} alt="" width={48} height={48} densities={[1, 2]} format="webp" />
    <blockquote class="quote">
      <p>{quote}</p>
    </blockquote>
    <figcaption class="cap">
      <strong class="name">{name}</strong>
      <span class="role">{role}</span>
    </figcaption>
  </figure>
</section>

<style>
  .review-band {
    background: var(--color-ss-surface);
    color: #151515;
  }
  .review {
    box-sizing: border-box;
    width: min(var(--content-max), calc(100% - 2 * var(--content-pad)));
    margin: 0 auto;
    padding: 48px 0;
    text-align: center;
  }
  .mark {
    display: block;
    width: 48px;
    height: 48px;
    margin: 0 auto 16px;
  }
  .quote {
    margin: 0;
  }
  .quote p {
    margin: 0 0 16px;
    font-family: var(--font-heading);
    font-size: 18px;
    line-height: 1.6;
    color: #151515;
  }
  .cap {
    display: block;
    font-family: var(--font-heading);
    line-height: 1.4;
  }
  .name,
  .role {
    display: block;
    font-weight: 600;
  }
  .name {
    font-size: 18px;
    color: #151515;
  }
  .role {
    font-size: 16px;
    color: #323232;
  }
</style>
