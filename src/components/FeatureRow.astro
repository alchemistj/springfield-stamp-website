---
// Icon feature row ("Why Do Business with Us?"): round red icon, upper-case title, body copy.
// Desktop: icon on the left beside the body, title above the body. Mobile: everything centred in a stack.
//   <FeatureRow title="FAST TURNAROUND" icon={img}> body (slot) </FeatureRow>
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  icon: ImageMetadata;
  headingLevel?: "h3" | "h4";
  /** Upper-case the title with CSS (the live site does it for every row, whatever the source case). */
  uppercase?: boolean;
}
const { title, icon, headingLevel: Heading = "h3", uppercase = true } = Astro.props;
---

<div class="feature">
  <Image class="icon" src={icon} alt="" width={100} height={100} densities={[1, 2]} format="webp" />
  <Heading class:list={["title", { upper: uppercase }]}>{title}</Heading>
  <div class="body"><slot /></div>
</div>

<style>
  .feature {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .icon {
    width: 100px;
    height: 100px;
    margin-bottom: 15.5px;
  }
  .title {
    margin: 0 0 22.5px;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 20px;
    line-height: 35px;
    color: var(--color-ss-ink);
  }
  /* The live mobile layout has 16px more space under the 2nd and 3rd titles. */
  .feature + .feature .title {
    margin-bottom: 38.5px;
  }
  .upper {
    text-transform: uppercase;
  }
  .body {
    margin: 0;
    padding-bottom: 20px;
    text-align: left;
    font-family: var(--font-heading);
    font-size: 18px;
    line-height: 31.5px;
    color: #151515;
  }
  .body :global(p) {
    margin: 0;
  }
  .body :global(p + p) {
    margin-top: 14px;
  }
  .body :global(strong) {
    font-weight: 600;
  }
  @media (min-width: 1024px) {
    .feature {
      display: grid;
      grid-template-columns: 100px 1fr;
      grid-template-areas:
        ". title"
        "icon body";
      column-gap: 27px;
      align-items: start;
      padding-left: 11px;
      text-align: left;
    }
    .icon {
      grid-area: icon;
      margin: 1px 0 0;
    }
    .title {
      grid-area: title;
      margin: 0 0 8px !important;
      font-size: 18px;
      line-height: 31.5px;
    }
    .body {
      grid-area: body;
      padding-bottom: 0;
    }
  }
</style>
