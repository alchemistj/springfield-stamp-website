---
// Wrapper for a stack of <ProductRow>s. Desktop: one card, rounded on the outer corners only,
// with the rows butted together. Mobile: separate full-width blocks, photo on top, 40px apart.
---

<div class="rows"><slot /></div>

<style>
  .rows {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  @media (min-width: 1024px) {
    .rows {
      gap: 0;
      border-radius: var(--radius-card);
      overflow: hidden;
    }
  }
</style>
