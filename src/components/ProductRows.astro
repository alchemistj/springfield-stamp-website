---
// Wrapper for a stack of <ProductRow>s.
// Homepage (`boxed`) keeps the joined grey card. Other pages stay separate plain rows.
interface Props {
  boxed?: boolean;
}
const { boxed = false } = Astro.props;
---

<div class:list={["rows", { boxed }]}><slot /></div>

<style>
  .rows {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .rows.boxed {
    gap: 32px;
  }
  @media (min-width: 1024px) {
    .rows.boxed {
      gap: 0;
      border-radius: var(--radius-card);
      overflow: hidden;
    }
    .rows:not(.boxed) {
      gap: 48px;
    }
  }
</style>
