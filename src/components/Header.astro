---
// Site header. Desktop: logo, "1-Day Service!" banner, the phone as plain text (not a button), and the nav.
// Below 1024px: logo, a small Call button, and a hamburger, in one row. The Call button sits outside
// the menu. The menu lists the pages, then the phone as a plain text link.
import { headerNav, site } from "../data/site";
import { logoImage } from "../lib/inline-image";
import Icon from "./Icon.astro";
import Button from "./Button.astro";

interface Props {
  /** Current page path, to mark the active link with aria-current. */
  current?: string;
}
const { current } = Astro.props;
const logo = await logoImage("springfield-stamp-logo-black.png", 600, 6);
---

<header class="site-header" data-site-header>
  <div class="hd-inner">
    <a class="logo" href="/" aria-label="Springfield Stamp & Engraving: home">
      <img
        src={logo.uri}
        width={logo.width}
        height={logo.height}
        alt="springfield stamp logo"
        decoding="sync"
        data-logo-bytes={logo.bytes}
      />
    </a>
    <p class="banner">{site.banner}</p>
    <a class="phone-link" href={site.phone.tel}>
      <Icon name="phone-alt" class="phone-ico" />
      <span>{site.phone.display}</span>
    </a>
    <Button href={site.phone.tel} class="call-mini">Call</Button>
    <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
      <Icon name="menu" class="i-menu" />
      <Icon name="close" class="i-close" />
    </button>
    <nav class="nav-desktop" aria-label="Primary">
      <ul>
        {
          headerNav.map((item) => (
            <li>
              <a href={item.path} aria-current={current === item.path ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav id="mobile-menu" class="nav-mobile" aria-label="Primary (mobile)" hidden>
      <ul>
        {
          headerNav.map((item) => (
            <li>
              <a href={item.path} aria-current={current === item.path ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="menu-phone" href={site.phone.tel}>{site.phone.display}</a>
    </nav>
  </div>
  <noscript>
    <nav class="nav-noscript" aria-label="Primary">
      <ul>
        {
          headerNav.map((item) => (
            <li>
              <a href={item.path}>{item.label}</a>
            </li>
          ))
        }
      </ul>
      <a href={site.phone.tel}>{site.phone.display}</a>
    </nav>
  </noscript>
</header>
<div class="header-spacer" data-header-spacer></div>

<script>
  // Rule 5: hide on the way down, slide back on the way up. Runs after parse and
  // changes nothing until the first scroll, so the first frame stays the in-flow header.
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const spacer = document.querySelector<HTMLElement>("[data-header-spacer]");
  const toggle = header?.querySelector<HTMLButtonElement>(".nav-toggle");
  const menu = header?.querySelector<HTMLElement>("#mobile-menu");
  if (header && spacer && toggle && menu) {
    const THRESHOLD = 8;
    let lastY = window.scrollY;
    let ticking = false;
    const open = () => toggle.getAttribute("aria-expanded") === "true";
    const setOpen = (next: boolean) => {
      toggle.setAttribute("aria-expanded", next ? "true" : "false");
      toggle.setAttribute("aria-label", next ? "Close menu" : "Open menu");
      menu.hidden = !next;
      header.classList.toggle("menu-open", next);
    };
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !open()) return;
      setOpen(false);
      toggle.focus();
    });
    toggle.addEventListener("click", () => {
      const next = !open();
      setOpen(next);
      if (next) show();
      else if (window.scrollY <= 0) atTop();
    });
    const locked = () => {
      if (open()) return true;
      const active = document.activeElement;
      return active instanceof Element && header.contains(active);
    };
    const atTop = () => {
      header.classList.remove("is-fixed", "is-hidden");
      spacer.classList.remove("is-on");
    };
    const show = () => {
      spacer.classList.add("is-on");
      header.classList.add("is-fixed");
      header.classList.remove("is-hidden");
    };
    const hide = () => {
      spacer.classList.add("is-on");
      header.classList.add("is-fixed", "is-hidden");
    };
    const update = () => {
      ticking = false;
      const y = window.scrollY;
      const dy = y - lastY;
      if (y <= 0) atTop();
      else if (locked()) show();
      else if (dy > THRESHOLD) hide();
      else if (dy < -THRESHOLD) show();
      lastY = y;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true },
    );
    header.addEventListener("focusin", () => {
      if (window.scrollY > 0) show();
    });
  }
</script>

<style>
  .site-header {
    position: relative;
    z-index: 40;
    height: var(--header-h);
    background: #fff;
    box-shadow: var(--shadow-header);
  }
  .site-header.is-fixed {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    transform: translateY(0);
    transition: transform 200ms ease;
  }
  .site-header.is-fixed.is-hidden {
    transform: translateY(-100%);
  }
  .header-spacer {
    height: 0;
  }
  .header-spacer.is-on {
    height: var(--header-h);
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header.is-fixed {
      transition: none;
    }
  }
  .hd-inner {
    position: relative;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 8px;
    height: 100%;
    margin: 0 auto;
    padding: 0 16px;
    width: 100%;
  }
  .logo {
    display: flex;
    align-items: center;
    flex: 0 0 200px;
    width: 200px;
    max-width: 200px;
    min-width: 200px;
  }
  .logo img {
    display: block;
    width: 100%;
    height: auto;
  }
  .banner,
  .phone-link {
    display: none;
  }
  .hd-inner :global(.call-mini) {
    flex: none;
    margin-left: auto;
  }
  .nav-toggle {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-right: -6px;
    padding: 0;
    border: 0;
    background: transparent;
    color: #111;
    cursor: pointer;
  }
  .nav-toggle :global(svg) {
    width: 28px;
    height: 28px;
  }
  .nav-toggle :global(.i-close) {
    display: none;
  }
  .site-header.menu-open .nav-toggle :global(.i-menu) {
    display: none;
  }
  .site-header.menu-open .nav-toggle :global(.i-close) {
    display: block;
  }
  .nav-desktop {
    display: none;
  }
  .nav-mobile {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 20;
    background: #fff;
    box-shadow: var(--shadow-header);
  }
  .nav-mobile[hidden] {
    display: none;
  }
  .nav-mobile ul,
  .nav-desktop ul,
  .nav-noscript ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav-mobile a,
  .nav-noscript a {
    display: block;
    padding: 10px 32px;
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 16px;
    line-height: 32px;
    text-transform: uppercase;
    text-decoration: none;
    color: rgba(10, 10, 10, 0.85);
  }
  .menu-phone {
    text-transform: none;
    font-weight: 600;
  }
  .nav-noscript {
    background: #fff;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  @media (min-width: 1024px) {
    .hd-inner {
      display: block;
      padding: 0;
      width: min(var(--w-header), calc(100% - 2 * var(--content-pad)));
    }
    .logo {
      position: absolute;
      top: 25px;
      left: 0;
      width: 249px;
      max-width: none;
    }
    .banner {
      position: absolute;
      top: 24px;
      right: 220px;
      display: block;
      margin: 0;
      font-family: var(--font-heading);
      font-weight: 600;
      font-size: 21px;
      line-height: 36.75px;
      color: #746b6a;
      white-space: nowrap;
    }
    .phone-link {
      position: absolute;
      top: 28px;
      right: 0;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: #3a3a3a;
      font-family: var(--font-heading);
      font-size: 18px;
      font-weight: 600;
      line-height: 1.2;
      letter-spacing: normal;
      text-decoration: none;
      background: none;
      white-space: nowrap;
    }
    .phone-link :global(.phone-ico) {
      flex: none;
      width: 18px;
      height: 18px;
      color: var(--color-ss-phone-icon);
    }
    .hd-inner :global(.call-mini),
    .nav-toggle,
    .nav-mobile {
      display: none;
    }
    .nav-desktop {
      position: absolute;
      top: 84px;
      right: 10px;
      display: block;
    }
    .nav-desktop ul {
      display: flex;
      gap: 16px;
    }
    .nav-desktop a {
      display: block;
      font-family: var(--font-heading);
      font-weight: 500;
      font-size: 16px;
      line-height: 32px;
      text-transform: uppercase;
      text-decoration: none;
      color: rgba(10, 10, 10, 0.85);
    }
    .nav-desktop a:hover,
    .nav-desktop a[aria-current="page"] {
      color: var(--color-ss-red);
    }
    .nav-desktop a[aria-current="page"] {
      position: relative;
    }
    .nav-desktop a[aria-current="page"]::after {
      content: "";
      position: absolute;
      left: -10px;
      right: -10px;
      bottom: -5px;
      height: 3px;
      background: var(--color-ss-red);
    }
    .nav-noscript {
      display: none;
    }
  }

  @media (min-width: 1280px) {
    .nav-desktop ul {
      gap: 24px;
    }
  }
</style>
