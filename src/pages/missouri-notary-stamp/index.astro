---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroPhoto from "../../components/HeroPhoto.astro";
import Button from "../../components/Button.astro";
import Section from "../../components/Section.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import Icon from "../../components/Icon.astro";
import ProductRows from "../../components/ProductRows.astro";
import ProductRow from "../../components/ProductRow.astro";
import { Picture } from "astro:assets";
import { routeByKey } from "../../lib/routes";
import { notaryStamp as d } from "../../data/missouri-notary-stamp";
import { site } from "../../data/site";
import rectangle from "../../assets/springfield-stamps-rectangular.jpg";
import circular from "../../assets/springfield-stamps-circular.jpg";
import embosser from "../../assets/springfield-stamps-notary-embosser.jpg";
import journal from "../../assets/springfield-stamps-mobile.jpg";

const route = routeByKey("missouri-notary-stamp");
const oneStop = "One-Stop";
const [leadBefore, leadAfter] = d.hero.lead.split(oneStop);
const images = { rectangle, circular, embosser, journal };
const alts = {
  rectangle: "Gray Ideal 4913 rectangular self-inking stamp",
  circular: "Round black Ideal 400R self-inking notary stamp with a Notary Public seal on top",
  embosser: "Black desk notary embosser with a chrome seal plate and a black handle",
  journal: "Display of stamps, daters and name tags on a gold round table in front of the shop sign",
} as const;
---

<BaseLayout route={route} heroHeight={{ desktop: 490, mobile: 303 }}>
  <HeroPhoto
    slot="hero-photo"
    desktop={{ file: "springfield-stamps-0522.png", width: 1440, cropAspect: 1440 / 490, quality: 55 }}
    mobile={{ file: "springfield-hero-notary-stamps-1.png", width: 780, cropAspect: 390 / 303, cropX: 0.88, quality: 50 }}
  />

  <section slot="hero" class="hero" aria-labelledby="hero-title">
    <div class="hero-body">
      <div class="hero-in content-col">
        <h1 id="hero-title" class="h1">
          <span class="dark">{leadBefore}<span class="one-stop">{oneStop}</span>{leadAfter}</span>
          <span class="red">{d.hero.accent}</span>
        </h1>
      </div>
    </div>
  </section>

  <div class="notary-pg">
    <Section tone="white" class="intro-sec" padTop={[61, 17]} padBottom={[0, 20]}>
      <p class="intro">{d.intro}</p>
    </Section>

    <Section tone="white" class="cards-sec" padTop={[44, 26]} padBottom={[48, 40]}>
      <SectionTitle as="h2">{d.products.title}</SectionTitle>
      <ProductRows>
        {
          d.products.items.filter((p) => !p.mobileOnly).map((p, i) => (
            <ProductRow
              title={p.name}
              image={images[p.image]}
              imageAlt={alts[p.image]}
              reverse={i % 2 === 0}
              tone="plain"
              objectPosition={p.image === "circular" ? "center top" : "center"}
              ctaHref={site.phone.tel}
              ctaLabel="Call to Order"
            >
              <p class="price">{p.price}</p>
              {(Array.isArray(p.body) ? p.body : [p.body]).map((para) => (
                <p>{para}</p>
              ))}
              {p.mobileExtra && <p>{p.mobileExtra}</p>}
            </ProductRow>
          ))
        }
      </ProductRows>
      {
        d.products.items.filter((p) => p.mobileOnly).map((p) => (
          <article class:list={["card", "m-only"]}>
            <div class="pic">
              <Picture src={images[p.image]} alt={alts[p.image]} formats={["avif", "webp"]} fallbackFormat="webp" widths={[343, 686]} sizes="(min-width: 1024px) 343px, 100vw" quality={75} />
            </div>
            <div class="info">
              <h3 class="name">{p.name}</h3>
              <p class="price">{p.price}</p>
              <div class="desc">
                {(Array.isArray(p.body) ? p.body : [p.body]).map((para) => (
                  <p>{para}</p>
                ))}
                {p.mobileExtra && <p>{p.mobileExtra}</p>}
              </div>
              <Button href={d.products.buy.href} class="buy">{d.products.buy.label}</Button>
            </div>
          </article>
        ))
      }
    </Section>

    <Section tone="surface" bg="#f7f7f7" class="req-sec" padTop={[62, 41]} padBottom={[75, 17]}>
      <SectionTitle as="h2">{d.requirements.title}</SectionTitle>
      <p class="req-intro">{d.requirements.intro}</p>
      <ul class="req-list">
        {d.requirements.items.map((t) => <li>{t}</li>)}
      </ul>
      <p id="buy" class="req-outro">{d.requirements.outro}</p>
    </Section>

    <Section tone="maroon" class="buy-sec" padTop={[56, 51]} padBottom={[78, 62]}>
      <SectionTitle as="h2" tone="white">{d.buy.title}</SectionTitle>
      <p class="buy-text">{d.buy.body}</p>
      <div class="contact-lines">
        <p class="cl"><Icon name="phone-alt" class="cl-ico" /><span>{site.phone.display}</span></p>
        <p class="cl"><Icon name="mail" class="cl-ico" /><span>{site.email}</span></p>
      </div>
      <div class="buy-ctas">
        <Button href={site.phone.tel}>{d.buy.callLabel}</Button>
        <Button href={`mailto:${site.email}`} variant="secondary">{d.buy.emailLabel}</Button>
      </div>
    </Section>
  </div>
</BaseLayout>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    z-index: 1;
    padding-top: var(--hero-h);
  }
  .hero-body {
    background: #fff;
    padding: 34px 0 50px;
    border-bottom: 1px solid #e8e8e8;
    text-align: center;
  }
  .h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 32px;
    line-height: 42px;
    text-transform: uppercase;
  }
  .one-stop {
    white-space: nowrap;
  }
  .dark {
    color: var(--color-ss-text);
  }
  .red {
    color: var(--color-ss-red);
  }

  .notary-pg :global(.section-title) {
    text-transform: uppercase;
    text-wrap: balance;
  }
  .notary-pg :global(.cards-sec .section-title),
  .notary-pg :global(.req-sec .section-title) {
    color: var(--color-ss-red);
  }

  /* ---- Intro ---- */
  .intro,
  .req-intro,
  .req-outro,
  .buy-text {
    margin: 0;
    text-align: left;
    font-family: var(--font-heading);
    font-size: 18px;
    line-height: 31.5px;
    color: #151515;
  }
  /* ---- Journal card (mobile only). The other products are plain rows. ---- */
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #f8f8f8;
    border-radius: 20px;
  }
  .pic {
    margin: 0;
    background: #f8f8f8;
    line-height: 0;
  }
  .pic :global(picture),
  .pic :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    background: #f8f8f8;
  }
  .info {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: 16px 21px 24px;
    text-align: left;
  }
  .name {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 23px;
    line-height: 30px;
    color: var(--color-ss-red);
  }
  .price {
    margin: 0;
    padding-bottom: 14px;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 28px;
    line-height: 36px;
    color: var(--color-ss-text);
  }
  .desc {
    flex: 1;
    margin: 0;
    padding-bottom: 20px;
    text-align: left;
    font-family: var(--font-heading);
    font-size: 18px;
    line-height: 30px;
    color: #151515;
  }
  .desc p {
    margin: 0;
  }
  .desc p + p {
    margin-top: 12px;
  }
  .desc {
    align-self: stretch;
  }
  .info :global(.buy) {
    align-self: center;
  }

  /* ---- Requirements ---- */
  .req-intro {
    padding-top: 10px;
    text-align: center;
  }
  .req-list {
    margin: 0;
    padding: 20px 0 14px;
    list-style: none;
  }
  .req-list li {
    position: relative;
    margin: 0 0 14px;
    padding-left: 36px;
    font-family: var(--font-heading);
    font-size: 17px;
    line-height: 26.5px;
    color: #151515;
  }
  .req-list li::before {
    content: "";
    position: absolute;
    left: 1px;
    top: 4px;
    box-sizing: border-box;
    width: 18px;
    height: 18px;
    border: 2px solid #c81626;
    border-radius: 50%;
    background: radial-gradient(circle, #c81626 0 3px, transparent 3.5px);
  }
  .req-outro {
    padding-top: 22px;
    text-align: center;
  }

  /* ---- Buy band ---- */
  .buy-text {
    padding-top: 0;
    text-align: center;
    color: #fff;
  }
  .contact-lines {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: max-content;
    margin: 20px auto;
  }
  .cl {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 19px;
    line-height: 28px;
    color: #fff;
  }
  .cl :global(.cl-ico) {
    width: 24px;
    height: 24px;
    color: var(--color-ss-yellow);
    fill: currentColor;
  }
  .buy-ctas {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 15px;
  }

  /* Mobile parity (below 1024px): live type sizes and spacing at 390px. */
  @media (max-width: 1023px) {
    .h1 {
      font-size: 30px;
    }
    .m-only {
      margin-top: 20px;
    }
    .pic :global(img) {
      height: 220px;
      object-fit: cover;
    }
    .info {
      padding: 43px 21px 52px;
    }
    .price {
      padding-bottom: 18px;
    }
    .desc {
      padding-bottom: 20px;
      line-height: 30.6px;
    }
    .card.m-only .info {
      padding-top: 23px;
    }
    .notary-pg :global(.req-sec .section-title) {
      margin: 0 auto;
    }
    .req-list {
      padding-bottom: 30px;
    }
    .buy-text {
      padding-bottom: 20px;
    }
    .contact-lines {
      gap: 12px;
      margin: 16px auto;
    }
    .cl {
      gap: 20px;
      font-size: 18px;
    }
    .req-list li {
      margin-bottom: 15px;
      padding-left: 38px;
      font-size: 18px;
      line-height: 28.8px;
    }
    .req-list li::before {
      top: 6px;
    }
    .notary-pg :global(.cards-sec .section-title) {
      font-size: 25px;
      line-height: 32.5px;
    }
    .notary-pg :global(.req-sec .section-title) {
      /* 24px keeps "Stamp Requirements" on one line at 390. */
      font-size: 24px;
      line-height: 32px;
    }
    .notary-pg :global(.buy-sec .section-title) {
      font-size: 28px;
      line-height: 36.4px;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      height: var(--hero-h);
      padding-top: 0;
    }
    .hero-body {
      display: flex;
      align-items: center;
      height: 100%;
      box-sizing: border-box;
      padding: 0 0 20px;
      border-bottom: 0;
      background: transparent;
      text-align: left;
    }
    .h1 {
      max-width: 560px;
      padding-bottom: 8px;
      font-size: 41px;
      line-height: 53px;
    }
    .dark,
    .red {
      display: block;
    }
    .notary-pg :global(.section-title) {
      font-size: 33px;
      line-height: 41.25px;
    }
    .m-only {
      display: none;
    }
    .info {
      align-items: flex-start;
      padding: 24px 20px 20px;
      text-align: left;
    }
    .name {
      padding-bottom: 8px;
      font-size: 24px;
    }
    .price {
      padding-bottom: 20px;
    }
    .desc {
      line-height: 30.5px;
      font-size: 18px;
    }
    .info :global(.buy) {
      margin-left: auto;
      margin-right: auto;
    }
    .req-list {
      width: 100%;
      margin: 0;
      padding: 41px 0 22px 0;
    }
    .req-list li {
      font-size: 18px;
      line-height: 28px;
      margin-bottom: 23px;
      padding-left: 38px;
    }
    .req-intro {
      padding-top: 4px;
    }
    .req-outro {
      padding-top: 18px;
    }
    .buy-text {
      width: 100%;
      margin: 0 auto;
    }
    .contact-lines {
      flex-direction: row;
      gap: 32px;
      margin: 20px auto;
    }
    .cl {
      font-size: 25px;
      line-height: 36px;
    }
    .buy-ctas {
      flex-direction: row;
      justify-content: center;
    }
  }

  @media (min-width: 1440px) {
    .h1 {
      /* The first line stays at least 24px clear of the circular photo. */
      max-width: 510px;
    }
    .notary-pg :global(.buy-sec .section-title) {
      white-space: nowrap;
    }
  }
</style>
