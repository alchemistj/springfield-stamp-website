---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroPhoto from "../../components/HeroPhoto.astro";
import Button from "../../components/Button.astro";
import Section from "../../components/Section.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import ProductRows from "../../components/ProductRows.astro";
import ProductRow from "../../components/ProductRow.astro";
import WhyCards from "../../components/WhyCards.astro";
import FinalCta from "../../components/FinalCta.astro";
import Rich from "../../components/Rich.astro";
import Icon from "../../components/Icon.astro";
import { Picture } from "astro:assets";
import { routeByKey } from "../../lib/routes";
import { customStamps as d } from "../../data/custom-stamps";
import { site } from "../../data/site";
import idealLine from "../../assets/cutouts/ideal-line.jpg";
import maxlight from "../../assets/cutouts/maxlight.jpg";
import logoStamp from "../../assets/cutouts/logo-stamp.png";
import datersInks from "../../assets/cutouts/daters.jpg";
import notary4913 from "../../assets/cutouts/notary-4913.jpg";
import premium from "../../assets/springfield-stamps-premium.png";
import makeYourMark from "../../assets/make-your-mark-2.jpg";
import stampGrey from "../../assets/stamp-grey.png";
import turnaround from "../../assets/springfield-turnaround.png";
import csGrey from "../../assets/springfield-cs-grey.png";
import community from "../../assets/community-1.png";

const route = routeByKey("custom-stamps");
const rowImages = { selfInking: idealLine, signature: maxlight, logo: logoStamp, daters: datersInks, notary: notary4913 };
const icons = { detail: stampGrey, turnaround, service: csGrey, community };
---

<BaseLayout route={route} heroHeight={{ desktop: 503, mobile: 309 }}>
  <HeroPhoto
    slot="hero-photo"
    desktop={{ file: "springfield-stamp-custom-stamps-2.jpg", width: 1440, cropAspect: 1440 / 503, cropX: 0.5, quality: 50 }}
    mobile={{ file: "springfield-hero-2.png", width: 780, cropAspect: 390 / 309, cropX: 0.92, quality: 50 }}
  />

  <section slot="hero" class="hero" aria-labelledby="hero-title">
    <div class="hero-body">
      <div class="hero-in content-col">
        <p class="brand">{d.hero.brand}</p>
        <h1 id="hero-title" class="h1">{d.hero.h1}</h1>
      </div>
    </div>
  </section>

  <div class="custom-pg">
  <Section tone="white" class="intro-sec" padTop={[48, 40]} padBottom={[32, 28]}>
    {d.intro.map((para) => (
      <p class="intro"><Rich parts={para} /></p>
    ))}
  </Section>

  <Section tone="white" class="find-sec" padTop={[40, 32]} padBottom={[64, 40]}>
    <SectionTitle as="h2" class="bal">{d.find.title}</SectionTitle>
    <div class="find-intro">
      <div class="find-text">
        {d.find.body.map((para) => (
          <p>
            <Rich parts={para} />
          </p>
        ))}
      </div>
      <div class="find-img">
        <Picture src={premium} alt='Round "Premium Quality" stamp mark with a smudged postmark across the top' formats={["avif", "webp"]} fallbackFormat="webp" widths={[214, 428]} sizes="214px" quality={80} />
      </div>
    </div>
    <div class="rows">
      <ProductRows>
        {
          d.find.rows.map((r, i) => (
            <ProductRow
              title={r.title}
              image={rowImages[r.image]}
              imageAlt={r.imageAlt}
              reverse={i % 2 === 0}
              tone="plain"
              cutout
              ctaHref={r.cta?.href}
              ctaLabel={r.cta?.label}
            >
              {r.body.map((para) => (
                <p>
                  <Rich parts={para} />
                </p>
              ))}
            </ProductRow>
          ))
        }
      </ProductRows>
    </div>
  </Section>

  <Section tone="surface" bg="#f6f6f6" class="why-sec" padTop={[56, 40]} padBottom={[64, 48]}>
    <SectionTitle as="h2">{d.why.title}</SectionTitle>
    <p class="why-intro"><Rich parts={d.why.intro} /></p>
    <p class="why-lead">{d.why.lead}</p>
    <WhyCards items={d.why.items.map((it) => ({ icon: icons[it.icon], title: it.title, body: it.body }))} />
  </Section>

  <Section tone="white" class="mark-sec" padTop={[70, 51]} padBottom={[50, 50]}>
    <SectionTitle as="h2">{d.mark.title}</SectionTitle>
    <div class="mark">
      <div class="mark-copy">
        <p class="mark-lead">{d.mark.lead}</p>
        <p class="mark-p">
          <Icon name="phone" class="mark-ico" /><strong>{d.mark.contactLabel}</strong>{d.mark.contactBody}
        </p>
        <p class="mark-p">
          {d.mark.callPrefix}<a href={site.phone.tel}>{site.phone.display}</a>{d.mark.callMiddle}<a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      </div>
      <div class="mark-img">
        <Picture src={makeYourMark} alt="Group of stamps: a dater, a Trodat COMPLETED stamp, a pink notary embosser, a slim black stamp and a red pocket stamp" formats={["avif", "webp"]} fallbackFormat="webp" widths={[354, 400, 800]} sizes="(min-width: 1024px) 380px, 100vw" quality={75} />
      </div>
    </div>
  </Section>

  <FinalCta class="ready-sec">
    <SectionTitle as="h2" tone="white">{d.ready.title}</SectionTitle>
    <p class="ready-text">{d.ready.body}</p>
    <p class="call-h">{d.ready.callHeading}</p>
    <div class="final-actions">
      <Button href={d.ready.cta.href}>{d.ready.cta.label}</Button>
      <Button href={`mailto:${site.email}`} variant="secondary">Email Us</Button>
    </div>
  </FinalCta>
  </div>
</BaseLayout>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    z-index: 1;
    padding-top: var(--hero-h);
  }
  .hero-body {
    background: #fff;
    padding: 16px 0 24px;
    text-align: center;
  }
  .brand {
    margin: 0;
    padding-bottom: 31px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 32px;
    line-height: 35px;
    text-transform: uppercase;
    color: var(--color-ss-red);
  }
  .h1 {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 28px;
    line-height: 36.5px;
    color: var(--color-ss-ink);
    /* Pretty keeps the last word with a neighbor. Balance parked "CUSTOM" alone. */
    text-wrap: pretty;
  }
  /* At 390 the column is 342px and "Neighborhood CUSTOM" needs 355, so the
     heading borrows 10px of the page pad. That lets pretty break as
     Your Friendly / Neighborhood CUSTOM / STAMP Experts! */
  @media (max-width: 420px) {
    .h1 {
      width: calc(100% + 20px);
      margin-inline: -10px;
    }
  }
  .intro + .intro {
    margin-top: 16px;
  }

  /* ---- Intro ---- */
  .intro {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 18px;
    line-height: 31.5px;
    text-align: center;
    color: #151515;
  }
  .intro :global(strong),
  .find-text :global(strong) {
    font-weight: 600;
  }

  /* ---- Find the perfect stamp ---- */
  .custom-pg :global(.ready-sec .section-title) {
    text-wrap: balance;
  }
  .find-intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 0 30px;
  }
  .find-text {
    margin: 0;
    padding: 0;
    text-align: left;
    font-family: var(--font-heading);
    font-size: 18px;
    line-height: 31.5px;
    color: #151515;
  }
  .find-text p {
    margin: 0;
  }
  .find-text p + p {
    margin-top: 16px;
  }
  .find-img {
    order: -1;
    width: 190px;
    margin-inline: auto;
    padding: 8px 0 24px;
  }
  .find-img :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .rows {
    width: 100%;
    margin: 0 auto;
  }
  .rows > :global(.rows) {
    gap: 32px;
  }
  .rows :global(.row-title) {
    margin: 16px 0 17px;
  }
  .rows :global(.copy) {
    padding: 0 3px;
  }
  .rows :global(.row-body) {
    text-align: left;
  }
  .rows :global(.row-cta) {
    margin-top: 16px;
  }

  /* ---- Ready band ---- */
  .ready-text {
    margin: 0;
    padding-bottom: 12px;
    text-align: center;
    font-family: var(--font-heading);
    font-size: 18px;
    line-height: 28.5px;
  }
  .call-h {
    margin: 0;
    padding-bottom: 0;
    text-align: center;
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 30px;
    text-transform: uppercase;
    color: #fff;
  }
  .custom-pg :global(.ready-sec .section-title),
  .custom-pg :global(.why-sec .section-title),
  .custom-pg :global(.mark-sec .section-title),
  .custom-pg :global(.find-sec .section-title) {
    font-size: 32px;
    line-height: 35px;
  }
  .custom-pg :global(.ready-sec .section-title) {
    line-height: 39.5px;
  }
  /* ---- Why choose ---- */
  .why-intro,
  .why-lead {
    margin: 0;
    text-align: center;
    font-family: var(--font-heading);
    font-size: 18px;
    line-height: 28.5px;
    color: #151515;
  }
  .why-intro {
    padding-bottom: 28px;
  }
  .why-lead {
    padding-bottom: 28px;
  }
  .why-intro :global(strong) {
    font-weight: 600;
  }
  .custom-pg :global(.why-sec .section-title),
  .custom-pg :global(.find-sec .section-title) {
    text-transform: uppercase;
  }
  .custom-pg :global(.ready-sec .section-title),
  .custom-pg :global(.mark-sec .section-title) {
    text-transform: uppercase;
  }

  /* ---- Make your mark ---- */
  .mark {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .mark-lead,
  .mark-p {
    margin: 0 0 20px;
    font-family: var(--font-heading);
    font-size: 18px;
    line-height: 26px;
    text-align: center;
    color: #151515;
  }
  .mark-p a {
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .mark-p strong {
    font-weight: 600;
  }
  .mark-p :global(.mark-ico) {
    display: inline-block;
    width: 18px;
    height: 18px;
    margin-right: 6px;
    vertical-align: -3px;
    color: var(--color-ss-ink);
  }
  .mark-img {
    order: -1;
  }
  .mark-img :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---- Mobile parity (below 1024px): live paddings, type sizes and spacing at 390px ---- */
  @media (max-width: 1023px) {
    .custom-pg :global(.why-sec .section-title),
    .custom-pg :global(.find-sec .section-title) {
      /* 26px keeps "Springfield Stamp" on one line at 390. 28px left "Stamp" alone. */
      font-size: 26px;
      line-height: 34px;
    }
    .custom-pg :global(.ready-sec .section-title) {
      font-size: 30px;
      line-height: 39px;
      padding-bottom: 16px;
    }
    .find-intro {
      margin-top: -10px;
      padding-bottom: 24px;
    }
    .find-img {
      align-self: center;
      width: 190px;
      margin-inline: auto;
      padding-bottom: 16px;
    }
    .rows {
      margin: 0 -1px;
    }
    .find-text :global(strong) {
      font-weight: 400;
    }
    .rows :global(.copy) {
      padding: 0 1px;
    }
    .rows :global(.row-title) {
      margin: 16px 0 13px;
      line-height: 35px;
    }
    .call-h {
      margin-top: 12px;
      font-size: 21px;
      line-height: 26.25px;
    }
    .custom-pg :global(.mark-sec .section-title) {
      /* 26px keeps "Springfield Stamp" on one line at 390. 28px left "Stamp" alone. */
      font-size: 26px;
      line-height: 34px;
      padding-bottom: 38px;
    }
    .ready-text {
      padding-bottom: 12px;
      font-size: 19px;
      line-height: 30.4px;
    }
    .why-intro,
    .why-lead {
      line-height: 31.5px;
    }
    .mark-lead,
    .mark-p {
      margin-bottom: 28.8px;
      line-height: 28.8px;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      height: var(--hero-h);
      padding-top: 0;
    }
    .hero-body {
      display: flex;
      align-items: center;
      height: 100%;
      box-sizing: border-box;
      padding: 0 0 22px;
      background: transparent;
      text-align: left;
    }
    .hero-in {
      padding-left: 0;
    }
    .brand {
      max-width: 480px;
      padding-bottom: 24px;
      font-size: 45px;
      line-height: 56px;
    }
    .h1 {
      max-width: 480px;
      font-size: 34.5px;
      line-height: 45px;
      color: #fff;
    }
    .intro {
      text-align: left;
    }
    .rows > :global(.rows) {
      gap: 48px;
    }
    .rows :global(.row-title) {
      margin: 4px 0 16px;
    }
    .rows :global(.copy) {
      padding: 16px 56px 16px 51px;
    }
    .rows :global(.row-body) {
      margin-bottom: 0;
      text-align: left;
    }
    .find-intro {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      margin-top: -20px;
      padding: 0 0 36px;
    }
    .find-text {
      flex: 1 1 auto;
      min-width: 0;
      width: auto;
      padding: 0;
      text-align: left;
      line-height: 31.5px;
    }
    .find-img {
      order: 0;
      flex: 0 0 42%;
      width: auto;
      max-width: 42%;
      padding: 0;
    }
    .call-h {
      padding-bottom: 0;
      font-size: 24px;
    }
    .custom-pg :global(.find-sec .section-title),
    .custom-pg :global(.ready-sec .section-title) {
      margin: 0 auto;
    }
    .ready-text {
      margin: 0 auto;
    }
    .why-intro,
    .why-lead {
      line-height: 31.5px;
    }
    .why-intro {
      padding: 6px 0 30px;
    }
    .why-lead {
      padding-bottom: 38px;
    }
    .sec-title-d :global(.section-title),
    .custom-pg :global(.find-sec .section-title),
    .custom-pg :global(.ready-sec .section-title),
    .custom-pg :global(.why-sec .section-title),
    .custom-pg :global(.mark-sec .section-title) {
      font-size: 36px;
      line-height: 45px;
    }
    .mark {
      flex-direction: row;
      align-items: center;
      gap: 40px;
      padding-top: 13px;
    }
    .mark-copy {
      flex: 1 1 auto;
      min-width: 0;
    }
    .mark-lead,
    .mark-p {
      margin-bottom: 32px;
      text-align: left;
      line-height: 29px;
    }
    .mark-img {
      order: 0;
      flex: 0 0 42%;
      max-width: 42%;
    }
  }
</style>
