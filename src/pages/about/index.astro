---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroPhoto from "../../components/HeroPhoto.astro";
import Button from "../../components/Button.astro";
import FinalCta from "../../components/FinalCta.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import Rich from "../../components/Rich.astro";
import { routeByKey } from "../../lib/routes";
import { about } from "../../data/about";
import { site } from "../../data/site";

const route = routeByKey("about");
---

<BaseLayout route={route} heroHeight={{ desktop: 411, mobile: 219 }}>
  <HeroPhoto
    slot="hero-photo"
    desktop={{ file: "springfield-stamp-hero-about3.jpg", width: 1920, quality: 45, position: "100% 50%" }}
    mobile={{ file: "springfield-stamp-about.jpeg", width: 780, quality: 45, position: "50% 39%" }}
  />

  <section slot="hero" class="hero" aria-labelledby="about-title">
    <div class="hero-in content-col">
      <p class="kicker">{about.kicker}</p>
      <h1 id="about-title" class="h1">{about.h1}</h1>
    </div>
  </section>

  <section class="story">
    <div class="story-in content-col">
      <div class="story-desktop">
        {about.story.map((p, i) => <p class:list={["p", { first: i === 0 }]}><Rich parts={p} /></p>)}
      </div>
      <p class="p story-mobile"><Rich parts={about.storyMobile} /></p>
    </div>
  </section>

  <section class="why">
    <div class="why-in content-col">
      <h2 class="why-title">{about.why.title}</h2>
      {about.why.paragraphs.map((p) => <p class="p"><Rich parts={p} /></p>)}
    </div>
  </section>

  <FinalCta class="closing">
    <SectionTitle as="h2" tone="white">{about.closing.title}</SectionTitle>
    <p class="closing-text"><Rich parts={about.closing.body} /></p>
    <div class="final-actions">
      <Button href={about.closing.cta.href}>{about.closing.cta.label}</Button>
      <Button href={`mailto:${site.email}`} variant="secondary">Email Us</Button>
    </div>
  </FinalCta>
</BaseLayout>

<style>
  /* ---- Hero: photo is absolute (HeroPhoto); the title block sits on top on desktop and below the photo on mobile ---- */
  .hero {
    position: relative;
    z-index: 1;
    padding-top: var(--hero-h);
    text-align: center;
  }
  .hero-in {
    padding: 33px 0 32px;
    background: #fff;
  }
  .kicker,
  .h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 30px;
    line-height: 33px;
    color: var(--color-ss-red);
    text-transform: uppercase;
  }
  /* Both words of "Springfield Stamp" stay on one line inside the dark wedge. */
  .h1 {
    font-size: 27px;
    line-height: 33px;
  }

  /* ---- Story ---- */
  .story {
    background: #fff;
    padding: 65px 0 67px;
  }
  .story-in,
  .why-in {
    text-align: center;
  }
  .p {
    margin: 0 0 25.5px;
    font-family: var(--font-heading);
    font-size: 18px;
    line-height: 31.5px;
    color: #161a1d;
  }
  .p :global(strong) {
    font-weight: 600;
  }
  .story-desktop {
    display: block;
  }
  .story-mobile {
    margin: 8px 0 0;
  }

  /* ---- Why choose ---- */
  .why {
    background: var(--color-ss-surface);
    padding: 40px 0 50px;
  }
  .why-title {
    margin: 0;
    padding-bottom: 32px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 26px;
    line-height: 34px;
    color: var(--color-ss-red);
  }
  .why .p {
    margin-bottom: 22px;
  }
  .why .p:last-child {
    margin-bottom: 0;
  }

  /* ---- Closing band ---- */
  .closing-text {
    margin: 0;
    padding-bottom: 0;
    font-family: var(--font-heading);
    font-size: 24px;
    line-height: 34.8px;
  }
  .closing-text :global(strong) {
    font-weight: 600;
  }
  .closing-text :global(strong:first-child) {
    font-family: var(--font-display);
    font-weight: 400;
  }
  @media (min-width: 1024px) {
    .hero {
      height: var(--hero-h);
      padding-top: 0;
      text-align: left;
    }
    /* The photo's yellow stripe cuts into the left side. The heading stays in the
       dark area, so this box is narrower than the 900px column and the type steps
       down where the wedge is too narrow for "SPRINGFIELD" at 40px. */
    .hero-in {
      width: 230px;
      margin-left: 24px;
      margin-right: auto;
      background: transparent;
      padding: 200px 0 0;
    }
    .kicker,
    .h1 {
      font-size: 18px;
      line-height: 26px;
    }
    .story {
      padding: 63px 0 67px;
    }
    .p.first {
      margin-bottom: 35.5px;
    }
    .p {
      line-height: 31.5px;
    }
    .why-title {
      font-size: 36px;
      line-height: 46.8px;
      padding-bottom: 36px;
    }
    .why .p {
      margin-bottom: 26px;
    }
    .why .p:nth-last-child(2) {
      margin-bottom: 36px;
    }
    .why {
      padding: 40px 0 65px;
    }
    .closing-text {
      margin: 0 auto;
      font-size: 27px;
      line-height: 43.2px;
      padding-bottom: 0;
    }
  }

  @media (min-width: 1200px) {
    .hero-in {
      width: 260px;
      margin-left: max(24px, calc((100% - var(--content-max)) / 2));
      padding-top: 149px;
    }
    .kicker,
    .h1 {
      font-size: 20px;
      line-height: 28px;
    }
  }

  @media (min-width: 1280px) {
    .hero-in {
      width: 290px;
    }
    .kicker,
    .h1 {
      font-size: 23px;
      line-height: 32px;
    }
  }

  @media (min-width: 1440px) {
    .hero-in {
      width: 350px;
    }
    .kicker {
      font-size: 28px;
      line-height: 38px;
    }
    .h1 {
      /* 26px ends the line short of the yellow slash. 28px ran into it. */
      font-size: 26px;
      line-height: 36px;
    }
  }

  @media (min-width: 1800px) {
    .hero-in {
      width: 520px;
    }
  }
</style>
