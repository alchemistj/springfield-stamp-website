---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroPhoto from "../components/HeroPhoto.astro";
import Button from "../components/Button.astro";
import Section from "../components/Section.astro";
import SectionTitle from "../components/SectionTitle.astro";
import ProductRows from "../components/ProductRows.astro";
import ProductRow from "../components/ProductRow.astro";
import Testimonial from "../components/Testimonial.astro";
import FeatureRow from "../components/FeatureRow.astro";
import FinalCta from "../components/FinalCta.astro";
import Rich from "../components/Rich.astro";
import { Picture } from "astro:assets";
import { routeByKey } from "../lib/routes";
import { home } from "../data/home";
import { aboutStorefront, homeIcons, homeProductImages } from "../lib/home-images";

const route = routeByKey("home");
const [sarah, john, jane] = home.workflow.testimonials;
if (!sarah || !john || !jane) throw new Error("Home page expects three testimonials");
const iconFor = homeIcons;
---

<BaseLayout route={route} heroHeight={{ desktop: 562, mobile: 588 }}>
  <HeroPhoto
    slot="hero-photo"
    alt="Springfield Stamp & Engraving storefront"
    desktop={{ file: "docs/designer-header/springfield-stamps-header-textured.png", width: 2100, quality: 50, position: "right bottom" }}
    mobile={{ file: "home-hero-bg.jpg", width: 840, quality: 72, position: "36% 42%" }}
  />

  <section slot="hero" class="hero" aria-labelledby="hero-title">
    <div class="hero-body">
      <div class="hero-in">
        <div class="hero-copy">
          <p class="kicker">{home.hero.kicker}</p>
          <h1 id="hero-title" class="h1">
            {home.hero.h1Lead} {home.hero.h1Rest}
          </h1>
          <p class="sub">
            {home.hero.sub[0]} {home.hero.sub[1]}
          </p>
          <div class="ctas">
            <Button href={home.hero.callCta.href}>
              <span class="hero-call-long">{home.hero.callCta.label}</span>
              <span class="hero-call-short">Call Now</span>
            </Button>
            <Button href={home.hero.emailCta.href} variant="secondary">{home.hero.emailCta.label}</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Section tone="surface" class="help-sec" padTop={[81, 51]} padBottom={[80, 70]}>
    <SectionTitle as="h2">{home.help.title}</SectionTitle>
    <div class="help-gap"></div>
    <ProductRows boxed>
      {
        home.help.products.map((p, i) => (
          <ProductRow
            title={p.title}
            image={p.image ? homeProductImages[p.image] : undefined}
            imageAlt={p.imageAlt}
            reverse={i % 2 === 0}
            tone={i >= 4 ? "card-alt" : "card"}
            ctaHref={p.cta?.href}
            ctaLabel={p.cta?.label}
            objectPosition={p.image === "customStamps" ? "center bottom" : "center"}
            banner={p.image === "customStamps"}
          >
            {p.body.map((para) => (
              <p>
                <Rich parts={para} />
              </p>
            ))}
          </ProductRow>
        ))
      }
    </ProductRows>
  </Section>

  <Testimonial quote={sarah.quote} name={sarah.name} role={sarah.role} />

  <Section tone="maroon" padTop={[56, 48]} padBottom={[56, 48]}>
    <SectionTitle as="h2" tone="white">{home.workflow.title}</SectionTitle>
    <p class="intro">{home.workflow.intro}</p>
    <p class="outro"><Rich parts={home.workflow.outro} /></p>
    <div class="outro-cta">
      <Button href={home.workflow.cta.href}>{home.workflow.cta.label}</Button>
    </div>
  </Section>

  <Testimonial quote={john.quote} name={john.name} role={john.role} />

  <Section tone="white" padTop={[79, 51]} padBottom={[85, 41]}>
    <SectionTitle as="h2">{home.why.title}</SectionTitle>
    <div class="why">
      {
        home.why.items.map((f) => (
          <FeatureRow title={f.title} icon={iconFor[f.icon]}>
            {f.body.map((para) => (
              <p>
                <Rich parts={para} />
              </p>
            ))}
          </FeatureRow>
        ))
      }
    </div>
  </Section>

  <Testimonial quote={jane.quote} name={jane.name} role={jane.role} />

  <Section tone="about" padTop={[80, 64]} padBottom={[80, 82]}>
    <div class="about">
      <div class="about-media">
        <Picture
          src={aboutStorefront}
          alt="Springfield Stamp & Engraving storefront on S. Glenstone Ave. with red lettering, an open sign and a 1 Day Service sign"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          widths={[303, 513, 1026]}
          sizes="(min-width: 1024px) 420px, 100vw"
          quality={75}
        />
      </div>
      <div class="about-copy">
        <SectionTitle as="h2" align="left">{home.about.title}</SectionTitle>
        {home.about.body.map((para) => (
          <p class="about-body">
            <Rich parts={para} />
          </p>
        ))}
        <div class="about-cta">
          <Button href={home.about.cta.href}>{home.about.cta.label}</Button>
        </div>
      </div>
    </div>
  </Section>

  <FinalCta>
    <SectionTitle as="h2" tone="white">{home.finalCta.title}</SectionTitle>
    <p>{home.finalCta.body}</p>
    <div class="final-actions">
      <Button href={home.finalCta.call.href}>{home.finalCta.call.label}</Button>
      <Button href={home.finalCta.email.href} variant="secondary">{home.finalCta.email.label}</Button>
    </div>
  </FinalCta>
</BaseLayout>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    z-index: 1;
    min-height: var(--hero-h);
  }
  /* Darkens the storefront enough for the white text and the red H1 to pass WCAG AA. */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: rgba(8, 10, 14, 0.86);
  }
  .hero-body {
    position: relative;
    z-index: 1;
    background: transparent;
    padding: 28px 22px 32px;
    text-align: center;
  }
  .hero-in {
    max-width: 303px;
    margin: 0 auto;
  }
  .kicker {
    margin: 0;
    padding-bottom: 20px;
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 20px;
    line-height: 26px;
    color: #fff;
  }
  .h1 {
    margin: 0;
    padding-bottom: 31px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 25px;
    line-height: 32.5px;
    color: var(--color-ss-red);
  }
  .hero-call-short {
    display: none;
  }
  .sub {
    margin: 0;
    padding-bottom: 20px;
    font-family: var(--font-heading);
    font-size: 18px;
    line-height: 27.9px;
    color: #fff;
  }
  .ctas {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 20px;
    margin: 21px -1px 0;
  }
  .hero :global(.btn-secondary) {
    color: #fff;
    border-color: #fff;
  }
  /* ---- How we can help ---- */
  .help-gap {
    height: 21px;
  }

  /* ---- Workflow band ---- */
  .intro {
    margin: 0;
    padding-bottom: 0;
    text-align: center;
    font-family: var(--font-heading);
    font-size: 19px;
    line-height: 33.25px;
  }
  :global(.help-sec .row-title) {
    text-align: left;
  }
  .outro {
    margin: 16px 0 0;
    padding: 0 0 20px;
    text-align: center;
    font-family: var(--font-heading);
    font-size: 19px;
    line-height: 33.25px;
  }
  .outro :global(strong) {
    font-weight: 600;
  }
  .outro-cta {
    display: flex;
    justify-content: center;
    padding-top: 17px;
  }

  /* ---- Why do business with us ---- */
  .why {
    display: flex;
    flex-direction: column;
    gap: 30px;
    padding-top: 16px;
  }

  /* ---- About ---- */
  .about {
    display: flex;
    flex-direction: column;
  }
  .about-media {
    order: 2;
    padding-top: 24px;
  }
  .about-media :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .about-copy {
    order: 1;
    padding-top: 0;
  }
  .about-body {
    margin: 0;
    padding-bottom: 0;
    font-family: var(--font-heading);
    font-size: 18px;
    line-height: 31.5px;
    color: #151515;
  }
  .about-body + .about-body {
    margin-top: 16px;
  }
  .about-body:last-of-type {
    padding-bottom: 20px;
  }
  .about-body :global(strong) {
    font-weight: 600;
  }
  .about-cta {
    display: flex;
    justify-content: center;
  }

  @media (min-width: 1024px) {
    .hero {
      display: flex;
      align-items: center;
      min-height: 0;
      padding-top: 0;
    }
    /* The designer photo is 2100×891. Matching that ratio shows the whole frame, so the
       product group on the right is not cropped. right/bottom keeps it in frame if the
       box is a pixel off. */
    .hero,
    :global(.atf .atf-photo) {
      height: calc(100vw * 891 / 2100);
    }
    :global(.atf .atf-photo) {
      object-position: right bottom;
    }
    /* The left half of the photo is already dark. Products stay on the right, undarkened. */
    .hero::before {
      background: none;
    }
    .hero-body {
      background: transparent;
      width: 100%;
      padding: 0;
      text-align: left;
    }
    .hero-in {
      box-sizing: border-box;
      width: min(1200px, calc(100% - 40px));
      max-width: none;
      margin-inline: auto;
    }
    /* Stay on the dark left side. The products begin at the horizontal midpoint. */
    .hero-copy {
      /* Wide enough for the H1 to settle on three lines at 1440 without shrinking the type. */
      max-width: min(610px, calc(50vw - 56px));
    }
    .kicker,
    .h1,
    .sub {
      max-width: none;
    }
    .kicker {
      padding-bottom: 8px;
      font-size: 22px;
      line-height: 30px;
      color: #fff;
    }
    .h1 {
      padding-bottom: 8px;
      font-size: 36px;
      line-height: 44px;
    }
    .sub {
      padding-bottom: 8px;
      font-size: 18px;
      line-height: 26px;
      color: #fff;
    }
    .ctas {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-start;
      gap: 8px;
      margin: 0 0 0 -1px;
    }
    .ctas :global(.btn) {
      width: auto;
      flex: 0 0 auto;
    }

    .help-gap {
      height: 16px;
    }

    .intro,
    .outro {
      width: 100%;
      margin-left: 0;
    }
    .intro {
      margin-top: -8px;
      padding-bottom: 24px;
    }
    .outro {
      margin-top: 26px;
      padding: 0 0 24px;
    }
    .outro-cta {
      padding-top: 11px;
      display: flex;
      justify-content: center;
    }

    .why {
      gap: 50px;
      padding-top: 23px;
    }

    .about {
      display: grid;
      grid-template-columns: minmax(0, 1.22fr) minmax(0, 1fr);
      column-gap: 24px;
    }
    .about-media {
      order: 2;
    }
    .about-media :global(img) {
      width: 100%;
      height: auto;
      object-fit: contain;
      object-position: center top;
    }
    .about-copy {
      order: 1;
      padding-top: 1px;
    }
    .about-body:last-of-type {
      padding-bottom: 24px;
    }
    .about-cta {
      justify-content: flex-start;
    }
  }

  @media (max-width: 767px) {
    .hero-call-long {
      display: none;
    }
    .hero-call-short {
      display: inline;
    }
  }

  /* From 1280 the frame is tall enough for the original desktop type. */
  @media (min-width: 1280px) {
    .kicker {
      padding-bottom: 26px;
      font-size: 24px;
      line-height: 33.6px;
    }
    .h1 {
      padding-bottom: 27px;
      font-size: 45px;
      line-height: 56.25px;
    }
    .sub {
      padding-bottom: 24px;
      font-size: 22px;
      line-height: 31.9px;
    }
  }

  /* At 1440 the 45px H1 needs a 680px measure to land on three lines. The text column
     stays centred, and the copy's right edge stays at or left of 52% of the viewport
     so it does not cross onto the product group. */
  @media (min-width: 1440px) {
    .hero-in {
      width: 1304px;
    }
    .hero-copy {
      max-width: 680px;
    }
  }
</style>
