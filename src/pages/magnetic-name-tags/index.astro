---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroPhoto from "../../components/HeroPhoto.astro";
import Button from "../../components/Button.astro";
import Section from "../../components/Section.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import ProductRows from "../../components/ProductRows.astro";
import ProductRow from "../../components/ProductRow.astro";
import WhyCards from "../../components/WhyCards.astro";
import FinalCta from "../../components/FinalCta.astro";
import Rich from "../../components/Rich.astro";
import { Picture, Image } from "astro:assets";
import { routeByKey } from "../../lib/routes";
import { magneticNameTags as d } from "../../data/magnetic-name-tags";
import { site } from "../../data/site";
import classic from "../../assets/cutouts/classic.jpg";
import logoTag from "../../assets/cutouts/logo.jpg";
import engraved from "../../assets/cutouts/engraved.jpg";
import fullColor from "../../assets/cutouts/full-color.jpg";
import photoTag from "../../assets/cutouts/photo.png";
import designTags from "../../assets/magnetic-tags-4.png";
import personShirt from "../../assets/people/shirt.png";
import personOffice from "../../assets/people/office.png";
import personLab from "../../assets/people/lab.png";
import wall from "../../assets/springfield-stamp-name-tags.jpg";
import breakTheIce from "../../assets/break-the-ice.png";
import boostBrand from "../../assets/boost-brand.png";
import promote from "../../assets/promote.png";
import improve from "../../assets/improve.png";
import enhance from "../../assets/enhance.png";
import stampGrey from "../../assets/stamp-grey.png";
import turnaround from "../../assets/springfield-turnaround.png";
import csGrey from "../../assets/springfield-cs-grey.png";
import community from "../../assets/community-1.png";

const route = routeByKey("magnetic-name-tags");
const rowImages = { classic, logo: logoTag, engraved, fullColor, photo: photoTag };
const people = [
  { src: personShirt, pos: "center 55%" },
  { src: personOffice, pos: "center" },
  { src: personLab, pos: "center 35%" },
];
const moreColon = d.more.title.indexOf(":");
const moreLead = d.more.title.slice(0, moreColon + 1);
const moreRest = d.more.title.slice(moreColon + 1).trim();
const nameAt = moreLead.indexOf("Name Tags");
const moreBefore = moreLead.slice(0, nameAt);
const moreName = moreLead.slice(nameAt);
const benefitIcons = { breakTheIce, boostBrand, promote, improve, enhance };
const whyIcons = { quality: stampGrey, speed: turnaround, touch: csGrey, community };
---

<BaseLayout route={route} heroHeight={{ desktop: 476, mobile: 309 }}>
  <HeroPhoto
    slot="hero-photo"
    desktop={{ file: "springfield-stamp-nametags2.jpg", width: 1440, cropAspect: 1440 / 476, cropX: 0.5, quality: 50 }}
    mobile={{ file: "springfield-stamp-nametags2.jpg", width: 780, cropAspect: 390 / 309, cropX: 0.8, quality: 50 }}
  />

  <section slot="hero" class="hero" aria-labelledby="hero-title">
    <div class="hero-body">
      <div class="hero-in content-col">
        <p class="brand">{d.hero.brand}</p>
        <h1 id="hero-title" class="h1">{d.hero.lead} {d.hero.rest}</h1>
      </div>
    </div>
  </section>

  <div class="mag-pg">
    <Section tone="white" class="intro-sec" padTop={[53, 37]} padBottom={[8, 0]}>
      <p class="p intro-p"><Rich parts={d.intro.hello} /></p>
      <p class="p intro-p"><Rich parts={d.intro.pride} /></p>
      <div class="call-plain">
        <p class="call-h">{d.intro.callHeading}</p>
        <div class="call-btn"><Button href={d.intro.callCta.href}>{d.intro.callCta.label}</Button></div>
      </div>
      <p class="p intro-p"><Rich parts={d.intro.whether} /></p>
    </Section>

    <Section tone="white" class="find-sec" padTop={[16, 0]} padBottom={[48, 32]}>
      <SectionTitle as="h2">{d.find.title}</SectionTitle>
      <p class="p centered find-lead">{d.find.lead}</p>
      <div class="rows">
        <ProductRows>
          {
            d.find.rows.map((r, i) => (
              <ProductRow title={r.title} image={rowImages[r.image]} imageAlt={r.imageAlt} reverse={i % 2 === 0} tone="plain" cutout>
                {(Array.isArray(r.body) ? r.body : [r.body]).map((para) => (
                  <p>{para}</p>
                ))}
              </ProductRow>
            ))
          }
        </ProductRows>
      </div>
    </Section>

    <Section tone="maroon" class="unique-sec" padTop={[58, 51]} padBottom={[50, 50]}>
      <SectionTitle as="h2" tone="white">{d.unique.title}</SectionTitle>
      <p class="u-text"><Rich parts={d.unique.body} /></p>
      <p class="u-text">{d.unique.contact}</p>
      <p class="u-call">{d.unique.callLine}</p>
      <div class="u-btn"><Button href={d.unique.cta.href}>{d.unique.cta.label}</Button></div>
    </Section>

    <Section tone="white" class="design-sec" padTop={[62, 51]} padBottom={[75, 77]}>
      <SectionTitle as="h2" class="grey-title">{d.design.title}</SectionTitle>
      <div class="design">
        <div class="design-img">
          <Image src={designTags} alt="Two white name tags: a Humane Society tag for Mr. Poe Poe and a Missouri Master Gardener tag for Jerry Doughty" width={285} height={274} densities={[1, 2]} format="webp" />
        </div>
        <div class="design-steps">
          {d.design.body.map((para) => (
            <p class="p"><Rich parts={para} /></p>
          ))}
        </div>
      </div>
      <SectionTitle as="h2" class="grey-title power-title">{d.power.title}</SectionTitle>
      <p class="p centered power-lead">{d.power.lead}</p>
      <div class="benefits">
        {
          d.power.benefits.map((b) => (
            <div class="benefit">
              <Image class="b-ico" src={benefitIcons[b.icon]} alt="" width={100} height={100} densities={[1, 2]} format="webp" />
              <div>
                <h3 class="b-title">{b.title}</h3>
                <p class="b-body"><Rich parts={b.body} /></p>
              </div>
            </div>
          ))
        }
      </div>
    </Section>

    <Section tone="surface" bg="#f8f8f8" class="more-sec" padTop={[48, 40]} padBottom={[16, 16]}>
      <SectionTitle as="h2" class="more-title">{moreBefore}<span class="more-line">{moreName}</span>{" "}<br />{moreRest}</SectionTitle>
      <div class="more">
        <div class="more-copy">
          {d.more.body.map((para) => (
            <p class="p"><Rich parts={para} /></p>
          ))}
          <ul class="bullets">
            {d.more.bullets.map((t) => <li>{t}</li>)}
          </ul>
        </div>
        <div class="more-wall">
          <Picture src={wall} alt="Wall display of many sample name tags in different colors, shapes and materials, including wood, metal and photo ID badges" formats={["avif", "webp"]} fallbackFormat="webp" widths={[400, 800]} sizes="(min-width: 1024px) 360px, 100vw" quality={75} />
        </div>
      </div>
      <div class="trio">
        {
          people.map((person, i) => (
            <div class="panel" style={`--pos:${person.pos}`}>
              <Image
                src={person.src}
                alt={i === 0 ? "Three photos of people wearing name tags: a man in a T-shirt, two coworkers in black suits with a clipboard, and a woman in a lab coat" : ""}
                width={person.src.width}
                height={person.src.height}
                densities={[1, 2]}
                format="webp"
              />
            </div>
          ))
        }
      </div>
    </Section>

    <Section tone="white" class="why-sec" padTop={[16, 24]} padBottom={[32, 32]}>
      <SectionTitle as="h2">{d.why.title}</SectionTitle>
      <p class="p centered why-lead"><Rich parts={d.why.lead} /></p>
      <WhyCards items={d.why.items.map((it) => ({ icon: whyIcons[it.icon], title: it.title, body: it.body }))} />
    </Section>

    <FinalCta class="ready-sec">
      <SectionTitle as="h2" tone="white">{d.ready.title}</SectionTitle>
      <p class="r-text">{d.ready.before}<a href={site.phone.tel}>{site.phone.display}</a>{d.ready.after}</p>
      <div class="final-actions">
        <Button href={site.phone.tel}>Call Now</Button>
        <Button href={`mailto:${site.email}`} variant="secondary">Email Us</Button>
      </div>
    </FinalCta>
  </div>
</BaseLayout>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    z-index: 1;
    padding-top: var(--hero-h);
  }
  .hero-body {
    background: #fff;
    padding: 33px 0 24px;
    text-align: center;
  }
  .brand {
    display: none;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 45px;
    line-height: 56px;
    text-transform: uppercase;
    color: var(--color-ss-red);
  }
  .h1 {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 28px;
    line-height: 37px;
    color: var(--color-ss-ink);
  }
  /* ---- Shared text ---- */
  .p {
    margin: 0 0 25px;
    font-family: var(--font-heading);
    font-size: 18px;
    line-height: 31.5px;
    color: #151515;
  }
  .p :global(strong) {
    font-weight: 600;
  }
  .centered {
    text-align: center;
  }
  .intro-p,
  .find-lead,
  .why-lead,
  .power-lead {
    text-align: left;
  }
  .call-plain {
    margin: 0 0 24px;
    text-align: center;
  }
  .call-h {
    margin: 0;
    padding-bottom: 20px;
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 30px;
    text-transform: uppercase;
    color: var(--color-ss-red);
  }
  .call-btn {
    display: flex;
    justify-content: center;
  }
  .call-btn :global(.btn) {
    width: auto;
    max-width: 100%;
  }

  /* ---- Find ---- */
  .find-lead {
    margin-bottom: 34px;
  }
  .rows {
    width: 100%;
    margin: 0 auto;
  }
  .rows :global(.rows) {
    gap: 32px;
  }
  .rows :global(.copy) {
    padding: 0;
  }
  .rows :global(.row-title) {
    margin: 16px 0 14px;
    font-size: 16px;
    line-height: 24px;
  }
  .rows :global(.row-body) {
    text-align: left;
  }

  /* ---- Unique band ---- */
  .u-text,
  .u-call {
    margin: 0 0 20px;
    padding: 0;
    text-align: center;
    font-family: var(--font-heading);
    font-size: 18px;
    line-height: 1.65;
    color: #fff;
  }
  .r-text {
    margin: 0;
    text-align: center;
    font-family: var(--font-heading);
    font-size: 18px;
    line-height: 1.65;
    color: #fff;
  }
  .u-text :global(strong) {
    font-weight: 600;
  }
  .u-call {
    margin-bottom: 20px;
    font-weight: 600;
    font-size: 22px;
    line-height: 28px;
  }
  .u-btn {
    display: flex;
    justify-content: center;
  }
  .u-btn :global(.btn) {
    max-width: 100%;
  }

  /* ---- Design / power ---- */
  .mag-pg :global(.design-sec .grey-title) {
    color: #585858;
  }
  .design {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 20px;
  }
  .design-steps {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .design-steps .p {
    margin: 0;
  }
  .mag-pg :global(.section-title) {
    font-size: 28px;
    line-height: 33.6px;
  }
  .design-img {
    order: 0;
    margin: 0 auto;
  }
  .design-img :global(img) {
    display: block;
    width: min(285px, 100%);
    height: auto;
    object-fit: contain;
  }
  .power-lead {
    margin-bottom: 30px;
  }
  .benefits {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }
  .benefit {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    text-align: left;
  }
  .b-ico {
    align-self: flex-start;
    width: 100px;
    height: 100px;
    margin-bottom: 14px;
  }
  .b-title {
    margin: 0 0 14px;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 18px;
    line-height: 28px;
    text-transform: uppercase;
    color: var(--color-ss-ink);
  }
  .b-body {
    margin: 0;
    text-align: left;
    font-family: var(--font-heading);
    font-size: 18px;
    line-height: 31.5px;
    color: #151515;
  }
  .b-body :global(strong) {
    font-weight: 600;
  }

  /* ---- More ---- */
  .more {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .more-wall :global(img) {
    display: block;
    width: 100%;
    height: 220px;
    object-fit: cover;
    object-position: center;
  }
  .trio {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 24px;
  }
  .panel {
    position: relative;
    overflow: hidden;
    aspect-ratio: 8 / 5;
    border-radius: 16px;
  }
  .panel :global(img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos, center);
  }
  :global(h2.more-title) {
    text-wrap: wrap;
  }
  .more-line {
    white-space: nowrap;
  }
  .bullets {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bullets li {
    position: relative;
    margin: 0 0 16px;
    padding-left: 38px;
    font-family: var(--font-heading);
    font-size: 18px;
    line-height: 29px;
    color: #151515;
  }
  .bullets li::before {
    content: "";
    position: absolute;
    left: 10px;
    top: 7px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-ss-red);
  }

  /* ---- Why / ready ---- */
  .why-lead {
    margin-bottom: 30px;
  }
  .r-text a {
    font-weight: 600;
    text-decoration: none;
    color: var(--color-ss-yellow);
  }
  .r-text {
    margin: 0;
  }

  /* ---- Mobile parity (below 1024px): live paddings, type sizes and spacing at 390px ---- */
  @media (max-width: 1023px) {
    /* The intro band's bottom padding is 0, so the last paragraph margin was
       escaping and leaving a white strip above the grey product section. */
    :global(.intro-sec) {
      display: flow-root;
    }
    .mag-pg :global(.section-title) {
      /* 24px lets "Building Connection", "Springfield Stamp?" and "they deserve?" share a line. */
      font-size: 24px;
    }
    .mag-pg :global(.why-sec .section-title) {
      padding-bottom: 32px;
    }
    .why-lead {
      margin-bottom: 16px;
    }
    .mag-pg :global(.ready-sec .section-title) {
      padding-bottom: 23px;
    }
    .mag-pg :global(.why-sec .card) {
      padding: 24px;
    }
    .mag-pg :global(.find-sec .section-title),
    .mag-pg :global(.unique-sec .section-title),
    .mag-pg :global(.ready-sec .section-title) {
      line-height: 36.4px;
    }
    .mag-pg :global(.design-sec .section-title),
    .mag-pg :global(.more-sec .section-title),
    .mag-pg :global(.why-sec .section-title) {
      line-height: 35px;
    }
    .mag-pg :global(.more-sec .section-title) {
      padding-bottom: 32px;
    }
    .more {
      gap: 16px;
    }
    .more-copy .p {
      margin-bottom: 16px;
    }
    .bullets li {
      margin-bottom: 10px;
      padding-left: 35px;
      font-size: 17px;
      line-height: 27.2px;
    }
    .bullets li:last-child {
      margin-bottom: 0;
    }
    .bullets li::before {
      left: 9px;
      top: 6px;
    }
    .benefits {
      gap: 24px;
    }
    .b-ico {
      margin-bottom: 12px;
    }
    .b-title {
      margin-bottom: 9px;
    }
    .u-text {
      margin-bottom: 16px;
      font-size: 19px;
      line-height: 33.25px;
    }
    .u-call {
      margin-bottom: 16px;
      padding: 0;
      text-align: center;
    }
    .intro-p {
      margin-bottom: 21px;
    }
    .intro-sec .intro-p:last-child {
      margin-bottom: 16px;
    }
    .call-h {
      padding-bottom: 25px;
      font-size: 23px;
    }
    .rows :global(.copy) {
      padding: 0 1px;
    }
    .rows :global(.row-title) {
      margin: 16px 0 12.5px;
      font-size: 18px;
      line-height: 25.2px;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      height: var(--hero-h);
      padding-top: 0;
    }
    .hero-body {
      display: flex;
      align-items: center;
      height: 100%;
      box-sizing: border-box;
      padding: 0 0 20px;
      background: transparent;
      text-align: left;
    }
    .hero-in {
      padding-left: 0;
    }
    .brand {
      display: block;
      padding-bottom: 24px;
    }
    .h1 {
      font-size: 34.5px;
      line-height: 44px;
      color: #fff;
    }
    .intro-p {
      text-align: left;
    }
    .intro-sec .intro-p:last-child {
      margin-bottom: 0;
    }
    .call-plain {
      margin: 0 0 28px;
    }
    .call-h {
      padding-bottom: 20px;
      font-size: 23px;
      line-height: 32px;
    }
    .mag-pg :global(.section-title) {
      font-size: 33px;
      line-height: 41.25px;
      text-wrap: balance;
    }
    .u-call {
      padding: 0;
    }
    .find-lead {
      margin-bottom: 40px;
    }
    .rows :global(.rows) {
      gap: 48px;
    }
    .rows :global(.copy) {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 30px 41px;
    }
    .rows :global(.row-title) {
      margin: 0 0 14px;
      font-size: 24px;
      line-height: 30px;
    }
    .rows :global(.row-body) {
      margin: 0;
      text-align: left;
    }
    .u-text {
      margin-left: auto;
      margin-right: auto;
      padding: 0;
      line-height: 32.5px;
    }
    .u-text + .u-text {
      margin-bottom: 26px;
    }
    .design {
      display: grid;
      grid-template-columns: minmax(180px, 240px) minmax(0, 1fr);
      align-items: start;
      column-gap: 28px;
      margin-bottom: 40px;
    }
    .design-steps {
      display: grid;
      width: 100%;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: start;
      justify-items: stretch;
      column-gap: 20px;
    }
    .design .p {
      width: 100%;
      max-width: none;
      min-width: 0;
      margin: 0;
      justify-self: stretch;
    }
    .design-img {
      max-width: 240px;
    }
    .design-img :global(img) {
      width: 100%;
      height: auto;
      object-fit: contain;
    }
    .benefits {
      width: 100%;
      gap: 47px;
      padding-top: 42px;
    }
    .benefit {
      flex-direction: row;
      align-items: flex-start;
      gap: 27px;
      text-align: left;
      padding-left: 10px;
    }
    .b-ico {
      align-self: flex-start;
      flex: none;
      margin: 0;
    }
    .b-title {
      margin: 0 0 14px;
      padding-top: 0;
      font-size: 17px;
    }
    .more {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      width: 100%;
      padding-top: 0;
      gap: 24px;
    }
    .more-copy {
      flex: 1 1 auto;
      width: auto;
      min-width: 0;
    }
    .more-wall {
      flex: 0 0 42%;
      width: auto;
      max-width: 42%;
    }
    .more-wall :global(img) {
      width: 100%;
      height: 100%;
      min-height: 220px;
      object-fit: cover;
    }
    .trio {
      gap: 24px;
      margin-top: 24px;
    }
    .why-lead {
      margin-bottom: 38px;
    }
    .r-text {
      margin: 0 auto;
    }
  }

</style>
