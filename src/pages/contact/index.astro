---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroPhoto from "../../components/HeroPhoto.astro";
import ContactForm from "../../components/ContactForm.astro";
import MapFacade from "../../components/MapFacade.astro";
import arrowRight from "../../assets/springfield-stamp-arrow2.png";
import arrowLeft from "../../assets/springfield-stamp-arrow1.png";
import { routeByKey } from "../../lib/routes";
import { contact } from "../../data/contact";

const route = routeByKey("contact");
const c = contact;
---

<BaseLayout route={route} wideHeader heroHeight={{ desktop: 482, mobile: 607 }}>
  <HeroPhoto
    slot="hero-photo"
    desktop={{ file: "springfield-stamps4.jpg", width: 1440, cropAspect: 1440 / 482, cropY: 0.55, quality: 40 }}
    mobile={{ file: "springfield-stamps4.jpg", width: 1000, quality: 35, position: "71% 50%" }}
  />

  <section slot="hero" class="hero" aria-labelledby="contact-title">
    <div class="hero-in">
      <h1 id="contact-title" class="h1">{c.h1}</h1>
      <p class="lead">
        {c.intro.lead}<strong>{c.intro.strong}</strong>{c.intro.tail}<br />
        <em>{c.intro.aside}</em>
      </p>
      <div class="reach">
        <Image class="arrow" src={arrowRight} alt="call springfield stamp" width={50} height={50} format="webp" densities={[1, 2]} loading="eager" />
        <p class="reach-t">{c.reach.label} <a href={c.reach.href}>{c.reach.phone}</a></p>
        <Image class="arrow" src={arrowLeft} alt="call springfield stamp" width={50} height={50} format="webp" densities={[1, 2]} loading="eager" />
      </div>
      <p class="plain">{c.allows}</p>
      <p class="plain">{c.lookForward}</p>
    </div>
  </section>

  <section class="details">
    <h2 class="details-h">{c.details.heading}</h2>
    <div class="details-grid">
      <address class="addr">
        <div class="row">
          <svg class="ico" viewBox="3 2 18 20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M4 21V3h11v6h5v12h-6v-4h-3v4H4zm3-15v2h2V6H7zm4 0v2h2V6h-2zM7 11v2h2v-2H7zm4 0v2h2v-2h-2zM7 16v2h2v-2H7zm8-5v2h2v-2h-2zm0 4v2h2v-2h-2z"></path></svg>
          <div>
            <p class="name">{c.details.name}</p>
            <p class="line">{c.details.address[0]}<br />{c.details.address[1]}</p>
          </div>
        </div>
        <div class="row">
          <svg class="ico" viewBox="0 0 512 512" aria-hidden="true" focusable="false"><path fill="currentColor" d="M497.39 361.8l-112-48a24 24 0 0 0-28 6.9l-49.6 60.6A370.66 370.66 0 0 1 130.6 204.11l60.6-49.6a23.94 23.94 0 0 0 6.9-28l-48-112A24.16 24.16 0 0 0 122.6.61l-104 24A24 24 0 0 0 0 48c0 256.5 207.5 464 464 464a24 24 0 0 0 23.4-18.6l24-104a24.29 24.29 0 0 0-14.01-27.6z"></path></svg>
          <a class="name tel" href={c.details.phoneHref}>{c.details.phone}</a>
        </div>
        <div class="row">
          <svg class="ico" viewBox="2 2 20 20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 5v5.2l4 2.4-.8 1.3L11 13V7h2z"></path></svg>
          <div>
            <p class="name">{c.details.hoursDays}</p>
            <p class="line">{c.details.hoursTimes}</p>
          </div>
        </div>
      </address>
      <div class="map-col"><MapFacade /></div>
    </div>
  </section>

  <section class="form-sec">
    <h2 class="form-h">{c.form.heading}</h2>
    <ContactForm />
  </section>
</BaseLayout>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    z-index: 1;
    height: var(--hero-h);
    background: rgba(0, 0, 0, 0.72);
    color: #fff;
    text-align: center;
    overflow: hidden;
  }
  .hero-in {
    box-sizing: border-box;
    max-width: 1100px;
    margin: 0 auto;
    padding: 50px 20px 0;
  }
  .h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 28px;
    line-height: 36px;
    color: var(--color-ss-red);
  }
  .lead {
    max-width: 310px;
    margin: 35px auto 0;
    font-family: var(--font-heading);
    font-size: 18px;
    line-height: 28px;
  }
  .lead strong {
    font-weight: 600;
  }
  .reach {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin: 16px 12px 0;
  }
  .arrow {
    flex: none;
    width: 36px;
    height: 36px;
  }
  .reach-t {
    max-width: 200px;
    margin: 0;
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 30px;
    text-transform: uppercase;
    color: var(--color-ss-red);
  }
  .reach-t a {
    color: var(--color-ss-yellow);
    text-decoration: none;
    white-space: nowrap;
  }
  .plain {
    max-width: 310px;
    margin: 39px auto 0;
    font-family: var(--font-heading);
    font-size: 18px;
    line-height: 28px;
  }
  .plain + .plain {
    max-width: 300px;
    font-size: 20px;
    margin-top: 30px;
    line-height: 35px;
  }

  /* ---- Details ---- */
  .details {
    padding: 39px 33px 0;
  }
  .details-h {
    margin: 0 auto;
    max-width: 1000px;
    text-align: center;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 22px;
    line-height: 31px;
    text-transform: uppercase;
    color: var(--color-ss-text);
  }
  .details-grid {
    display: flex;
    flex-direction: column;
    gap: 34px;
    align-items: center;
    max-width: 883px;
    margin: 45px auto 0;
  }
  .addr {
    align-self: stretch;
    padding-left: 22px;
    font-style: normal;
    color: #161a1d;
  }
  .row {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin-bottom: 20px;
  }
  .row:nth-child(2) {
    margin-bottom: 19px;
  }
  .ico {
    flex: none;
    width: 19px;
    height: 20px;
    margin: 5px 0 0 0;
    color: #c8162b;
  }
  .name,
  .line {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 18px;
    line-height: 29px;
    color: #161a1d;
  }
  .name {
    font-weight: 600;
  }
  .tel {
    text-decoration: none;
  }

  /* ---- Form ---- */
  .form-sec {
    padding: 48px 33px 66px;
  }
  .form-h {
    margin: 0 0 42px;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 25px;
    line-height: 30px;
    text-transform: uppercase;
    color: var(--color-ss-red);
  }

  @media (min-width: 1024px) {
    .hero-in {
      padding: 52px 40px 0 20px;
    }
    .h1 {
      font-size: 40px;
      line-height: 52px;
    }
    .lead {
      max-width: none;
      margin: 49px 0 0;
      font-size: 20px;
      line-height: 33px;
    }
    .reach {
      gap: 22px;
      margin-top: 19px;
    }
    .arrow {
      width: 49px;
      height: 49px;
    }
    .reach-t {
      font-size: 25px;
      line-height: 36px;
    }
    .plain {
      max-width: none;
      margin: 31px 0 0;
      font-size: 20px;
      line-height: 30px;
    }
    .plain + .plain {
      max-width: none;
      font-size: 20px;
      margin-top: 31px;
      line-height: 30px;
    }
    .reach {
      margin-left: 0;
      margin-right: 0;
    }
    .reach-t {
      max-width: none;
    }
    .reach + .plain {
      margin-top: 32px;
    }
    .details {
      padding-top: 56px;
    }
    .name,
    .line {
      line-height: 28px;
    }
    .row,
    .row:nth-child(2) {
      margin-bottom: 26px;
    }
    .details-h {
      font-size: 22px;
      line-height: 29px;
    }
    .details-grid {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 0;
      margin-top: 51px;
    }
    .addr {
      flex: none;
      align-self: center;
      width: 423px;
      padding: 12px 0 0 3px;
      box-sizing: border-box;
    }
    .form-sec {
      padding: 49px 0 66px;
    }
    .form-h {
      margin-bottom: 45px;
      font-size: 30px;
      line-height: 39px;
    }
  }
</style>
